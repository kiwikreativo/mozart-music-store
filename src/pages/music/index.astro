---
import { productsForGroup, accessoryProducts } from '../../data/catalog';
import '@phosphor-icons/web/bold';
import '@phosphor-icons/web/fill';
const products = [...productsForGroup('instrumentos'), ...productsForGroup('audio'), ...accessoryProducts];
const brands = [...new Set(products.map((p) => p.brand))];
const categories = ['Instrumentos', 'Audio', 'Accesorios'];
---
<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width"><title>Mozart Music Admin</title><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&amp;display=swap"><script is:inline>{`(()=>{const k='mozart-theme',r=document.documentElement;let t;try{t=localStorage.getItem(k)}catch{};t=t==='light'||t==='dark'?t:(matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light');r.dataset.theme=t;r.style.colorScheme=t})()`}</script></head><body>
<main class="music-admin" data-admin data-products={JSON.stringify(products)} data-brands={JSON.stringify(brands)} data-categories={JSON.stringify(categories)}>
  <aside class="admin-sidebar"><a class="admin-mark" href="/">MOZART<span>®</span></a><nav aria-label="Administración"><a class="is-active" href="/music/"><i class="ph-bold ph-squares-four"></i>Dashboard</a><a href="#products"><i class="ph-bold ph-package"></i>Products</a><button type="button" data-open-form><i class="ph-bold ph-plus-circle"></i>Add Product</button><a href="#profile"><i class="ph-bold ph-user-circle"></i>Profile</a></nav><button class="admin-logout" type="button"><i class="ph-bold ph-sign-out"></i>Logout</button></aside>
  <section class="admin-main">
    <header class="admin-header"><div class="admin-utilities"><label class="admin-search"><i class="ph-bold ph-magnifying-glass" aria-hidden="true"></i><input data-search type="search" placeholder="Search products" aria-label="Search products"></label><div class="admin-theme theme-switch" role="group" aria-label="Seleccionar tema"><button type="button" data-theme-choice="light" aria-label="Usar tema claro"><i class="ph-bold ph-sun" aria-hidden="true"></i></button><button type="button" data-theme-choice="dark" aria-label="Usar tema oscuro"><i class="ph-bold ph-moon" aria-hidden="true"></i></button></div><div class="admin-profile-wrapper"><button class="admin-profile" type="button" data-profile aria-expanded="false" aria-controls="admin-profile-menu"><span class="avatar">A</span><span>Admin</span><i class="ph-bold ph-caret-down" aria-hidden="true"></i></button><div id="admin-profile-menu" class="profile-menu" data-profile-menu hidden><button type="button" data-open-profile>Edit Profile</button><button type="button" data-open-password>Change Password</button><button type="button">Log Out</button></div></div></div></header>
    <div class="welcome-card"><div><p class="welcome-eyebrow">Mozart Music Store</p><h1>Hello, Admin</h1><p>It's good to see you again.</p></div><div class="welcome-art" aria-hidden="true"><i class="ph ph-music-notes"></i><i class="ph ph-waveform"></i></div></div>
    <section class="management" id="products"><div class="section-heading"><div><p class="section-kicker">Catalog workspace</p><h2>Product Management</h2></div><button class="primary-action" type="button" data-open-form><i class="ph-bold ph-plus" aria-hidden="true"></i>Add Product</button></div><div class="management-panel"><div class="panel-toolbar"><span data-count></span><div class="admin-filters"><select data-category-filter aria-label="Filter by category"><option value="all">All categories</option><option>Instrumentos</option><option>Audio</option><option>Accesorios</option></select><select data-instrument-filter aria-label="Filter by instrument"><option value="all">All instruments</option></select><select data-status-filter aria-label="Filter by status"><option value="all">All statuses</option><option>Disponible</option><option>Por encargo</option><option>Agotado</option></select><button type="button" data-clear-filters disabled>Clear filters</button></div></div><div class="product-table-wrap"><table><thead><tr><th>Product</th><th>Category</th><th>Instrument</th><th>Price</th><th>Status</th><th>Actions</th></tr></thead><tbody data-product-list></tbody></table></div><div class="mobile-product-list" data-mobile-list></div><div class="admin-empty" data-empty hidden>No products match the current filters.</div></div></section>
    <dialog class="product-modal" data-form-dialog><div class="form-card"><div class="section-heading"><div><p class="section-kicker">Catalog editor</p><h2 data-form-title>Add Product</h2></div><button class="icon-button" type="button" data-close-form aria-label="Close form"><i class="ph-bold ph-x" aria-hidden="true"></i></button></div><form data-product-form><input type="hidden" name="id"><div class="form-grid"><label>Product name<input required name="model" placeholder="Product name"></label><label>Brand<select required name="brand">{brands.map((brand) => <option>{brand}</option>)}</select></label><label>Category<select required name="category">{categories.map((category) => <option>{category}</option>)}</select></label><label>Price<input required type="number" min="0" name="price" placeholder="0"></label><label>Status<select name="availability"><option>Disponible</option><option>Por encargo</option><option>Agotado</option></select></label><label>Type<input name="type" placeholder="Product type"></label><label class="full-field">Description<textarea name="description" rows="4" placeholder="Add a short description"></textarea></label><div class="upload-field full-field"><span>Product image</span><label class="upload-drop" data-upload-drop><i class="ph-bold ph-cloud-arrow-up" aria-hidden="true"></i><b>Choose a file or drag it here</b><small>JPG, PNG or WEBP · 5 MB maximum</small><input type="file" name="imageFile" accept="image/jpeg,image/png,image/webp" data-image-input><button type="button" class="secondary-action" data-browse>Browse files</button></label><div class="image-preview" data-image-preview hidden></div></div></div><div class="form-actions"><button class="secondary-action" type="button" data-close-form>Cancel</button><button class="primary-action" type="submit">Create Product</button></div></form></div></dialog>
  </section>
  <dialog class="delete-dialog" data-delete-dialog><form method="dialog"><h2>Delete product?</h2><p>Are you sure you want to delete <strong data-delete-name></strong>?<br>This action cannot be undone.</p><div class="form-actions"><button class="secondary-action" value="cancel">Cancel</button><button class="danger-action" value="delete" data-confirm-delete>Delete</button></div></form></dialog>
</main>
<script>
const adminRoot=document.querySelector('[data-admin]');
if(adminRoot){
  const source=JSON.parse(adminRoot.dataset.products||'[]');
  source.forEach(p=>{const value=p.attributes?.instrumento;if(value!==undefined&&!Array.isArray(value))p.attributes.instrumento=[value]});
  adminRoot.dataset.products=JSON.stringify(source);
  const table=adminRoot.querySelector('[data-product-list]');
  const mobileList=adminRoot.querySelector('[data-mobile-list]');
  const search=adminRoot.querySelector('[data-search]');
  const cat=adminRoot.querySelector('[data-category-filter]');
  const instrument=adminRoot.querySelector('[data-instrument-filter]');
  const state=adminRoot.querySelector('[data-status-filter]');
  const categoryOf=p=>p.id.startsWith('accesorio')?'Accesorios':p.id.includes('audio')?'Audio':'Instrumentos';
  const instrumentsOf=p=>{const v=p.attributes?.instrumento; return Array.isArray(v)?v:[v||p.type]};
  const money=n=>new Intl.NumberFormat('es-CR',{style:'currency',currency:'CRC',maximumFractionDigits:0}).format(n);
  const draw=()=>{const query=(search?.value||'').toLowerCase();const rows=source.filter(p=>(!query||`${p.brand} ${p.model} ${p.type}`.toLowerCase().includes(query))&&(!cat||cat.value==='all'||categoryOf(p)===cat.value)&&(!instrument||instrument.value==='all'||instrumentsOf(p).includes(instrument.value))&&(!state||state.value==='all'||p.availability===state.value));if(table)table.innerHTML=rows.map(p=>`<tr><td><strong>${p.model}</strong><small>${p.type}</small></td><td>${categoryOf(p)}</td><td>${instrumentsOf(p).join(', ')}</td><td>${money(p.price)}</td><td><span class="status">${p.availability}</span></td><td><div class="row-actions"><button type="button" data-edit="${p.id}" aria-label="Edit ${p.model}"><i class="ph-bold ph-pencil-simple" aria-hidden="true"></i></button><button type="button" data-delete="${p.id}" aria-label="Delete ${p.model}"><i class="ph-bold ph-trash" aria-hidden="true"></i></button></div></td></tr>`).join('');if(mobileList)mobileList.innerHTML='';const count=adminRoot.querySelector('[data-count]');if(count)count.textContent=`${rows.length} products`;const empty=adminRoot.querySelector('[data-empty]');if(empty)empty.hidden=rows.length>0};
  [...new Set(source.flatMap(instrumentsOf))].forEach(v=>instrument?.insertAdjacentHTML('beforeend',`<option>${v}</option>`));
  [search,cat,instrument,state].forEach(el=>el?.addEventListener('input',draw));
  draw();
}
</script>
<script>
// Own each mounted dropdown once; discard document listeners before an Astro swap.
let disposeProfileMenu: (() => void) | undefined;
function initializeProfileMenu() {
  disposeProfileMenu?.();
  const trigger = document.querySelector<HTMLButtonElement>('[data-profile]');
  const menu = document.querySelector<HTMLElement>('[data-profile-menu]');
  if (!trigger || !menu) return;

  const controller = new AbortController();
  const options = { signal: controller.signal };
  let isProfileMenuOpen = false;
  function setProfileMenuState(open: boolean) {
    isProfileMenuOpen = open;
    menu!.hidden = !open;
    trigger!.setAttribute('aria-expanded', String(open));
  }
  setProfileMenuState(false);
  trigger.addEventListener('click', () => {
    setProfileMenuState(!isProfileMenuOpen);
  }, options);
  menu.addEventListener('click', (event) => {
    if (event.target instanceof Element && event.target.closest('button')) {
      setProfileMenuState(false);
      // Keep keyboard focus out of the now-hidden disclosure.
      if (menu.contains(document.activeElement)) trigger.focus();
    }
  }, options);
  document.addEventListener('click', (event) => {
    if (event.target instanceof Node &&
        !trigger.contains(event.target) && !menu.contains(event.target)) {
      setProfileMenuState(false);
    }
  }, options);
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && isProfileMenuOpen) {
      setProfileMenuState(false);
      trigger.focus();
    }
  }, options);
  document.addEventListener('focusin', (event) => {
    if (event.target instanceof Node &&
        !trigger.contains(event.target) && !menu.contains(event.target)) {
      setProfileMenuState(false);
    }
  }, options);
  disposeProfileMenu = () => {
    setProfileMenuState(false);
    controller.abort();
    disposeProfileMenu = undefined;
  };
}
initializeProfileMenu();
document.addEventListener('astro:page-load', initializeProfileMenu);
document.addEventListener('astro:before-swap', () => disposeProfileMenu?.());
window.addEventListener('pageshow', initializeProfileMenu);
</script>
</body></html>
<script>
const root=document.querySelector('[data-admin]'); if(root){const all=JSON.parse(root.dataset.products||'[]'); let items=[...all],editing=null,pending=null; const q=root.querySelector('[data-search]'),list=root.querySelector('[data-product-list]'),mobile=root.querySelector('[data-mobile-list]'),cat=root.querySelector('[data-category-filter]'),inst=root.querySelector('[data-instrument-filter]'),status=root.querySelector('[data-status-filter]'),clear=root.querySelector('[data-clear-filters]'),dialog=root.querySelector('[data-form-dialog]'),form=root.querySelector('[data-product-form]'),input=root.querySelector('[data-image-input]'),drop=root.querySelector('[data-upload-drop]'),preview=root.querySelector('[data-image-preview]'); const fmt=n=>new Intl.NumberFormat('es-CR',{style:'currency',currency:'CRC',maximumFractionDigits:0}).format(n),catOf=p=>p.id.startsWith('accesorio')?'Accesorios':p.id.includes('audio')?'Audio':'Instrumentos', instruments=[...new Set(all.flatMap(p=>p.attributes?.instrumento||[p.type]))]; inst.insertAdjacentHTML('beforeend',instruments.map(x=>`<option>${x}</option>`).join('')); const render=()=>{const s=q.value.toLowerCase(),shown=items.filter(p=>(!s||`${p.brand} ${p.model} ${p.type}`.toLowerCase().includes(s))&&(cat.value==='all'||catOf(p)===cat.value)&&(inst.value==='all'||(p.attributes?.instrumento||[p.type]).includes(inst.value))&&(status.value==='all'||p.availability===status.value)); root.querySelector('[data-count]').textContent=`${shown.length} products`; const row=p=>`<tr><td><strong>${p.model}</strong><small>${p.type}</small></td><td>${catOf(p)}</td><td>${(p.attributes?.instrumento||[p.type]).join(', ')}</td><td>${fmt(p.price)}</td><td><span class="status">${p.availability}</span></td><td><div class="row-actions"><button type="button" data-edit="${p.id}" aria-label="Edit ${p.model}"><i class="ph-bold ph-pencil-simple" aria-hidden="true"></i></button><button type="button" data-delete="${p.id}" aria-label="Delete ${p.model}"><i class="ph-bold ph-trash" aria-hidden="true"></i></button></div></td></tr>`; list.innerHTML=shown.map(row).join(''); mobile.innerHTML=shown.map(p=>`<article class="mobile-product"><div><strong>${p.model}</strong><small>${p.brand} · ${catOf(p)}</small></div><div><b>${fmt(p.price)}</b><span class="status">${p.availability}</span></div><div class="row-actions"><button type="button" data-edit="${p.id}">Edit</button><button type="button" data-delete="${p.id}">Delete</button></div></article>`).join(''); root.querySelector('[data-empty]').hidden=shown.length>0; clear.disabled=cat.value==='all'&&inst.value==='all'&&status.value==='all';}; const open=p=>{editing=p||null;form.reset();root.querySelector('[data-form-title]').textContent=p?'Edit Product':'Add Product';form.querySelector('[data-submit-form]')?.replaceChildren();form.querySelector('[type=submit]').textContent=p?'Save Changes':'Create Product';if(p) Object.entries(p).forEach(([k,v])=>{const el=form.elements.namedItem(k);if(el&&typeof v==='string')el.value=v});dialog.showModal();form.querySelector('input:not([type=hidden])')?.focus()}; root.addEventListener('click',e=>{const t=e.target.closest('[data-edit],[data-delete]');if(t){const p=items.find(x=>x.id===(t.dataset.edit||t.dataset.delete));if(t.dataset.edit)open(p);else{pending=p;root.querySelector('[data-delete-name]').textContent=`“${p.brand} ${p.model}”`;root.querySelector('[data-delete-dialog]')?.showModal()}}}); root.querySelectorAll('[data-open-form]').forEach(b=>b.addEventListener('click',()=>open())); root.querySelectorAll('[data-close-form]').forEach(b=>b.addEventListener('click',()=>dialog.close())); form.addEventListener('submit',e=>{e.preventDefault();const d=Object.fromEntries(new FormData(form));if(editing)items=items.map(p=>p.id===editing.id?{...p,...d,price:Number(d.price)}:p);else items.unshift({...all[0],...d,id:`local-${Date.now()}`,price:Number(d.price)});dialog.close();render()}); [q,cat,inst,status].forEach(el=>el.addEventListener('input',render));clear.addEventListener('click',()=>{cat.value=inst.value=status.value='all';render()}); root.querySelectorAll('[data-theme-choice]').forEach(b=>b.addEventListener('click',()=>{document.documentElement.dataset.theme=b.dataset.themeChoice;try{localStorage.setItem('mozart-theme',b.dataset.themeChoice)}catch{}})); const show=f=>{preview.hidden=false;preview.innerHTML=`<img src="${typeof f==='string'?f:URL.createObjectURL(f)}" alt="Selected product image"><span>${typeof f==='string'?'Current image':f.name}</span><button type="button" data-remove-image>Remove</button>`}; const handle=f=>{if(f&&f.type.startsWith('image/'))show(f)}; drop.addEventListener('click',e=>{if(e.target.closest('[data-browse]'))input.click();else if(e.target===drop||e.target.closest('b,small,i'))input.click()}); input.addEventListener('change',()=>handle(input.files[0])); drop.addEventListener('dragover',e=>{e.preventDefault();drop.classList.add('is-dragging')});drop.addEventListener('dragleave',()=>drop.classList.remove('is-dragging'));drop.addEventListener('drop',e=>{e.preventDefault();drop.classList.remove('is-dragging');handle(e.dataTransfer.files[0])}); preview.addEventListener('click',e=>{if(e.target.closest('[data-remove-image]')){preview.hidden=true;input.value=''}}); render();}
</script>
