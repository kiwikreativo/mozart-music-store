---
export const prerender = false;
import { catalogCategories, productsFor, accessoryProducts } from '../../data/catalog';
import AdminHeader from '../../components/admin/AdminHeader.astro';
import '../../styles/admin.css';
import '@phosphor-icons/web/bold';
import '@phosphor-icons/web/fill';
const familyBySlug: Record<string, string> = {guitarras:'Guitarras',bajos:'Bajos',baterias:'Baterías','pianos-y-teclados':'Pianos y teclados',platillos:'Percusión','bolillos-y-mallets':'Percusión','instrumentos-de-marcha':'Percusión','percusion-latina':'Percusión',ukeleles:'Ukeleles',vientos:'Vientos'};
const compatibleFamily: Record<string, string> = {Guitarra:'Guitarras',Bajo:'Bajos',Batería:'Baterías',Piano:'Pianos y teclados',Teclado:'Pianos y teclados',Ukelele:'Ukeleles',Congas:'Percusión',Bongós:'Percusión',Timbales:'Percusión',Saxofón:'Vientos',Trompeta:'Vientos',Flauta:'Vientos'};
const compatibleFamilies = (p) => [...new Set([p.attributes?.instrumento].flat().map(v=>compatibleFamily[v]).filter(Boolean))];
const products = [...catalogCategories.flatMap(c=>productsFor(c).map(p=>({...p,category:c.group==='audio'?'Audio':'Instrumentos',families:familyBySlug[c.slug]?[familyBySlug[c.slug]]:compatibleFamilies(p)}))), ...accessoryProducts.map(p=>({...p,category:'Accesorios',families:compatibleFamilies(p)}))];
const brands = [...new Set(products.map((p) => p.brand))];
const categories = ['Instrumentos', 'Audio', 'Accesorios'];
---
<!doctype html><html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width"><title>Administración de Mozart</title><link rel="stylesheet" href="/fonts/music/fonts.css"><script is:inline>{`(()=>{const k='mozart-theme',r=document.documentElement;let t;try{t=localStorage.getItem(k)}catch{};t=t==='light'||t==='dark'?t:(matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light');r.dataset.theme=t;r.style.colorScheme=t})()`}</script></head><body>
<main class="music-admin" data-admin data-products={JSON.stringify(products)} data-brands={JSON.stringify(brands)} data-categories={JSON.stringify(categories)}>
  <aside class="admin-sidebar"><a class="admin-mark" href="/">MOZART<span>®</span></a><nav aria-label="Administración"><a href="#products"><i class="ph-bold ph-package"></i>Productos</a><button type="button" data-open-form><i class="ph-bold ph-plus-circle"></i>Agregar producto</button></nav><button class="admin-logout" type="button" data-logout><i class="ph-bold ph-sign-out"></i>Cerrar sesión</button></aside>
  <section class="admin-main">
    <AdminHeader />
    <div class="welcome-card"><div><p class="welcome-eyebrow">Mozart Music Store</p><h1>Hola, Admin</h1><p>Qué gusto verte de nuevo.</p></div><div class="welcome-art" aria-hidden="true"><i class="ph ph-music-notes"></i><i class="ph ph-waveform"></i></div></div>
    <section class="management" id="products"><div class="section-heading"><div><p class="section-kicker">Administración del catálogo</p><h2>Gestión de productos</h2></div><button class="primary-action" type="button" data-open-form><i class="ph-bold ph-plus" aria-hidden="true"></i>Agregar producto</button></div><div class="management-panel"><div class="panel-toolbar"><span data-count></span><div class="admin-filters"><select data-category-filter aria-label="Filtrar por categoría"><option value="all">Todas las categorías</option><option>Instrumentos</option><option>Audio</option><option>Accesorios</option></select><select data-instrument-filter aria-label="Filtrar por instrumento"><option value="all">Todos los instrumentos</option></select><select data-status-filter aria-label="Filtrar por estado"><option value="all">Todos los estados</option><option>Disponible</option><option>Por encargo</option><option>Agotado</option></select><button type="button" data-clear-filters disabled>Limpiar filtros</button></div></div><div class="product-table-wrap"><table><thead><tr><th>Producto</th><th>Categoría</th><th>Instrumento</th><th>Precio</th><th>Estado</th><th>Acciones</th></tr></thead><tbody data-product-list></tbody></table></div><div class="mobile-product-list" data-mobile-list></div><div class="admin-empty" data-empty hidden>No hay productos que coincidan con los filtros.</div></div></section>
    <dialog class="product-modal" data-form-dialog><div class="form-card"><div class="section-heading"><div><p class="section-kicker">Editor del catálogo</p><h2 data-form-title>Agregar producto</h2></div><button class="icon-button" type="button" data-close-form aria-label="Cerrar formulario"><i class="ph-bold ph-x" aria-hidden="true"></i></button></div><form data-product-form><input type="hidden" name="id"><div class="form-grid"><label>Nombre del producto<input required name="model" placeholder="Nombre del producto"></label><label>Marca<select required name="brand">{brands.map((brand) => <option>{brand}</option>)}</select></label><label>Categoría<select required name="category">{categories.map((category) => <option>{category}</option>)}</select></label><label>Precio<input required type="number" min="0" name="price" placeholder="0"></label><label>Estado<select name="availability"><option>Disponible</option><option>Por encargo</option><option>Agotado</option></select></label><label>Tipo<input name="type" placeholder="Tipo de producto"></label><label class="full-field">Descripción<textarea name="description" rows="4" placeholder="Agrega una descripción breve"></textarea></label><div class="upload-field full-field"><span>Imagen del producto</span><label class="upload-drop" data-upload-drop><i class="ph-bold ph-cloud-arrow-up" aria-hidden="true"></i><b>Elige un archivo o arrástralo aquí</b><small>JPG, PNG o WEBP · Máximo 5 MB</small><input type="file" name="imageFile" accept="image/jpeg,image/png,image/webp" data-image-input><button type="button" class="secondary-action" data-browse>Buscar archivos</button></label><div class="image-preview" data-image-preview hidden></div></div></div><div class="form-actions"><button class="secondary-action" type="button" data-close-form>Cancelar</button><button class="primary-action" type="submit">Crear producto</button></div></form></div></dialog>
  </section>
  <dialog class="delete-dialog" data-delete-dialog><form method="dialog"><h2>¿Eliminar producto?</h2><p>¿Seguro que deseas eliminar <strong data-delete-name></strong>?<br>Esta acción no se puede deshacer.</p><div class="form-actions"><button class="secondary-action" value="cancel">Cancelar</button><button class="danger-action" value="delete" data-confirm-delete>Eliminar</button></div></form></dialog>
</main>


</body></html>
<script>
const root=document.querySelector('[data-admin]'); if(root){const all=JSON.parse(root.dataset.products||'[]'); let items=[...all],editing=null,pending=null; const q=root.querySelector('[data-search]'),list=root.querySelector('[data-product-list]'),mobile=root.querySelector('[data-mobile-list]'),cat=root.querySelector('[data-category-filter]'),inst=root.querySelector('[data-instrument-filter]'),status=root.querySelector('[data-status-filter]'),clear=root.querySelector('[data-clear-filters]'),dialog=root.querySelector('[data-form-dialog]'),form=root.querySelector('[data-product-form]'),input=root.querySelector('[data-image-input]'),drop=root.querySelector('[data-upload-drop]'),preview=root.querySelector('[data-image-preview]'); const fmt=n=>new Intl.NumberFormat('es-CR',{style:'currency',currency:'CRC',maximumFractionDigits:0}).format(n),catOf=p=>p.category, instruments=['Guitarras','Bajos','Baterías','Pianos y teclados','Percusión','Ukeleles','Vientos']; inst.insertAdjacentHTML('beforeend',instruments.map(x=>`<option>${x}</option>`).join('')); const render=()=>{const s=q.value.toLowerCase(),shown=items.filter(p=>(!s||`${p.brand} ${p.model} ${p.type}`.toLowerCase().includes(s))&&(cat.value==='all'||catOf(p)===cat.value)&&(inst.value==='all'||(p.families||[]).includes(inst.value))&&(status.value==='all'||p.availability===status.value)); root.querySelector('[data-count]').textContent=`${shown.length} productos`; const row=p=>`<tr><td><strong>${p.model}</strong><small>${p.type}</small></td><td>${catOf(p)}</td><td>${(p.families||[]).join(', ')||'Sin familia'}</td><td>${fmt(p.price)}</td><td><span class="status ${p.availability==='Disponible'?'status-available':p.availability==='Por encargo'?'status-order':'status-sold'}">${p.availability}</span></td><td><div class="row-actions"><button type="button" data-edit="${p.id}" aria-label="Editar ${p.model}"><i class="ph-bold ph-pencil-simple" aria-hidden="true"></i></button><button type="button" data-delete="${p.id}" aria-label="Eliminar ${p.model}"><i class="ph-bold ph-trash" aria-hidden="true"></i></button></div></td></tr>`; list.innerHTML=shown.map(row).join(''); mobile.innerHTML=shown.map(p=>`<article class="mobile-product"><div><strong>${p.model}</strong><small>${p.brand} · ${catOf(p)}</small></div><div><b>${fmt(p.price)}</b><span class="status ${p.availability==='Disponible'?'status-available':p.availability==='Por encargo'?'status-order':'status-sold'}">${p.availability}</span></div><div class="row-actions"><button type="button" data-edit="${p.id}">Editar</button><button type="button" data-delete="${p.id}">Eliminar</button></div></article>`).join(''); root.querySelector('[data-empty]').hidden=shown.length>0; clear.disabled=cat.value==='all'&&inst.value==='all'&&status.value==='all';}; const open=p=>{editing=p||null;form.reset();root.querySelector('[data-form-title]').textContent=p?'Editar producto':'Agregar producto';form.querySelector('[data-submit-form]')?.replaceChildren();form.querySelector('[type=submit]').textContent=p?'Guardar cambios':'Crear producto';['model','brand','category','price'].forEach(name=>form.elements.namedItem(name).required=!p);if(p) Object.entries(p).forEach(([k,v])=>{const el=form.elements.namedItem(k);if(el&&(typeof v==='string'||typeof v==='number'))el.value=String(v)});dialog.showModal();form.querySelector('input:not([type=hidden])')?.focus()}; root.addEventListener('click',e=>{const t=e.target.closest('[data-edit],[data-delete]');if(t){const p=items.find(x=>x.id===(t.dataset.edit||t.dataset.delete));if(t.dataset.edit)open(p);else{pending=p;root.querySelector('[data-delete-name]').textContent=`“${p.brand} ${p.model}”`;root.querySelector('[data-delete-dialog]')?.showModal()}}}); root.querySelectorAll('[data-open-form]').forEach(b=>b.addEventListener('click',()=>open())); root.querySelectorAll('[data-close-form]').forEach(b=>b.addEventListener('click',()=>dialog.close())); form.addEventListener('submit',e=>{e.preventDefault();const d={};for(const name of ['model','brand','category','price','availability','type','description']){const value=String(new FormData(form).get(name)||'').trim();if(value!=='')d[name]=name==='price'?Number(value):value;}if(editing)items=items.map(p=>p.id===editing.id?{...p,...d}:p);else items.unshift({...all[0],...d,families:[],id:`local-${Date.now()}`});dialog.close();render()}); [q,cat,inst,status].forEach(el=>el.addEventListener('input',render));clear.addEventListener('click',()=>{cat.value=inst.value=status.value='all';render()}); const show=f=>{preview.hidden=false;preview.innerHTML=`<img src="${typeof f==='string'?f:URL.createObjectURL(f)}" alt="Imagen seleccionada del producto"><span>${typeof f==='string'?'Imagen actual':f.name}</span><button type="button" data-remove-image>Quitar</button>`}; const handle=f=>{if(f&&f.type.startsWith('image/'))show(f)}; drop.addEventListener('click',e=>{if(e.target.closest('[data-browse]'))input.click();else if(e.target===drop||e.target.closest('b,small,i'))input.click()}); input.addEventListener('change',()=>handle(input.files[0])); drop.addEventListener('dragover',e=>{e.preventDefault();drop.classList.add('is-dragging')});drop.addEventListener('dragleave',()=>drop.classList.remove('is-dragging'));drop.addEventListener('drop',e=>{e.preventDefault();drop.classList.remove('is-dragging');handle(e.dataTransfer.files[0])}); preview.addEventListener('click',e=>{if(e.target.closest('[data-remove-image]')){preview.hidden=true;input.value=''}}); render();if(new URLSearchParams(location.search).get('agregar')==='1'){open();history.replaceState(null,'','/music/');}}
</script>



<script>
import { gsap } from 'gsap';
let disposeAtmosphere: (() => void) | undefined;
function initializeAtmosphere() {
  disposeAtmosphere?.();
  const art = document.querySelector<HTMLElement>('.welcome-art');
  if (!art) return;
  const media = gsap.matchMedia();
  media.add('(prefers-reduced-motion: no-preference)', () => {
    const drift = gsap.to(art, { y: -8, rotation: -3, duration: 5, repeat: -1, yoyo: true, ease: 'sine.inOut' });
    const visibility = () => document.hidden ? drift.pause() : drift.resume();
    document.addEventListener('visibilitychange', visibility);
    visibility();
    return () => document.removeEventListener('visibilitychange', visibility);
  });
  disposeAtmosphere = () => media.revert();
}
initializeAtmosphere();
document.addEventListener('astro:page-load', initializeAtmosphere);
document.addEventListener('astro:before-swap', () => disposeAtmosphere?.());
</script>



