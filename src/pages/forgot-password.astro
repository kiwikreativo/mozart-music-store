---
export const prerender = false;
import AdminAuthLayout from '../layouts/AdminAuthLayout.astro';
---
<AdminAuthLayout title="Recuperar contraseña">
  <main class="login-page">
    <section class="auth-card" aria-labelledby="recovery-title">
      <a class="auth-logo" href="/" aria-label="Mozart, ir a la tienda">MOZART<span>®</span></a>
      <h1 id="recovery-title">Recuperar contraseña</h1>
      <p class="auth-description">Ingresa el correo asociado a tu cuenta de administrador.</p>
      <form data-recovery-form="request" novalidate>
        <div class="auth-field">
          <label for="email">Correo electrónico <span aria-hidden="true">*</span></label>
          <input id="email" name="email" type="email" required maxlength="254" autocomplete="email" inputmode="email" placeholder="johndoe@gmail.com" aria-describedby="email-error" />
          <p class="field-error" id="email-error" hidden></p>
        </div>
        <p class="auth-feedback" data-recovery-feedback role="status" aria-live="polite" hidden></p>
        <button class="primary-action auth-submit" type="submit">Recuperar contraseña</button>
        <div class="auth-form-footer"><a class="auth-secondary-link" href="/music/login/">Volver a iniciar sesión</a></div>
      </form>
    </section>
  </main>
</AdminAuthLayout>
<script>import '../scripts/admin-password-recovery';</script>
