---
import CatalogPage from '../components/catalog/CatalogPage.astro';
import { catalogOverview, productsForGroup } from '../data/catalog';
import Layout from '../layouts/Layout.astro';
const whatsappNumber = import.meta.env.PUBLIC_WHATSAPP_NUMBER ?? '';
const category = catalogOverview('instrumentos');
const products = productsForGroup('instrumentos');
---
<Layout title="Instrumentos | Mozart"><CatalogPage {category} {products} {whatsappNumber} /></Layout>
