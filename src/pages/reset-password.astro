---
export const prerender = false;
import AdminAuthLayout from '../layouts/AdminAuthLayout.astro';
import PasswordField from '../components/admin/PasswordField.astro';
---
<AdminAuthLayout title="Restablecer contraseña">
  <main class="login-page">
    <section class="auth-card" aria-labelledby="reset-title">
      <a class="auth-logo" href="/" aria-label="Mozart, ir a la tienda">MOZART<span>®</span></a>
      <h1 id="reset-title">Restablecer contraseña</h1>
      <p class="auth-description">Ingresa y confirma una nueva contraseña para tu cuenta de administrador.</p>
      <form data-recovery-form="reset" novalidate>
        <PasswordField name="next" label="Nueva contraseña" />
        <PasswordField name="confirm" label="Confirmar nueva contraseña" />
        <section class="password-guidance" aria-label="Requisitos de contraseña">
          <div class="strength-heading"><span>Seguridad de la contraseña</span><span data-strength-label>Débil</span></div>
          <meter data-strength min="0" max="3" value="0" aria-label="Seguridad de la contraseña"></meter>
          <p>La contraseña debe contener:</p>
          <ul>
            <li data-rule="length"><i class="ph-bold ph-circle" aria-hidden="true"></i><span>Al menos 8 caracteres</span><span class="sr-only" data-rule-state>: pendiente</span></li>
            <li data-rule="uppercase"><i class="ph-bold ph-circle" aria-hidden="true"></i><span>Al menos una letra mayúscula</span><span class="sr-only" data-rule-state>: pendiente</span></li>
            <li data-rule="number"><i class="ph-bold ph-circle" aria-hidden="true"></i><span>Al menos un número</span><span class="sr-only" data-rule-state>: pendiente</span></li>
          </ul>
          <small>Máximo 128 caracteres.</small>
        </section>
        <p class="auth-feedback" data-recovery-feedback role="status" aria-live="polite" hidden></p>
        <button class="primary-action auth-submit" type="submit">Restablecer contraseña</button>
        <div class="auth-form-footer"><a class="auth-secondary-link" href="/music/login/">Volver a iniciar sesión</a></div>
      </form>
    </section>
  </main>
</AdminAuthLayout>
<script>import '../scripts/admin-password-recovery';</script>
