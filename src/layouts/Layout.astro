---
import Navbar from '../components/Navbar.astro';
import '@phosphor-icons/web/bold';


interface Props { title?: string }
const { title = 'Mozart — Instrumentos y accesorios' } = Astro.props;
const whatsappNumber = import.meta.env.PUBLIC_WHATSAPP_NUMBER ?? '';
const text = encodeURIComponent('Hola Mozart, quiero consultar por instrumentos disponibles.');
const whatsappUrl = whatsappNumber ? `https://wa.me/${whatsappNumber}?text=${text}` : `https://wa.me/?text=${text}`;
---
<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<script is:inline>
			(() => {
				const key = 'mozart-theme';
				const root = document.documentElement;
				let saved = null;
				try { saved = localStorage.getItem(key); } catch {}
				const theme = saved === 'light' || saved === 'dark'
					? saved
					: (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
				root.dataset.theme = theme;
				root.style.colorScheme = theme;
			})();
		</script>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="description" content="Instrumentos y accesorios para músicos en Alajuela, Costa Rica." />
		<title>{title}</title>
	</head>
	<body>
		<Navbar {whatsappUrl} />
		<slot />
	</body>
</html>

<style is:global>

	@import url('https://fonts.googleapis.com/css2?family=Elms+Sans:ital,wght@0,100..900;1,100..900&display=swap');
	:root {
