---
import type { CatalogCategory, CatalogProduct } from '../../data/catalog';
import { productsFor } from '../../data/catalog';
import CatalogCard from './CatalogCard.astro';
import CatalogFilters from './CatalogFilters.astro';
import { productDetailUrl } from '../../data/productDetails';
interface Props { category: CatalogCategory; whatsappNumber: string; products?: CatalogProduct[] }
const { category, whatsappNumber, products: suppliedProducts } = Astro.props;
const products = suppliedProducts ?? productsFor(category);
const accessoryMode = category.group === 'accesorios';
const isBrowseAllPage = category.slug === category.group;
const minPrice = Math.min(...products.map((product) => product.price));
const maxPrice = Math.max(...products.map((product) => product.price));
const whatsappLink = (product: string) => {
	const text = encodeURIComponent(`Hola Mozart, quiero consultar por ${product}.`);
	return whatsappNumber ? `https://wa.me/${whatsappNumber}?text=${text}` : `https://wa.me/?text=${text}`;
};
---
<main class="catalog-page">
	<header class="catalog-header"><p class="breadcrumb"><a href="/">Inicio</a><i class="ph-bold ph-caret-right" aria-hidden="true"></i>{isBrowseAllPage ? <strong>{category.title}</strong> : <><a href={`/${category.group}`}>{category.group === 'audio' ? 'Audio' : 'Instrumentos'}</a><i class="ph-bold ph-caret-right" aria-hidden="true"></i><strong>{category.title}</strong></>}</p><h1>{category.title}</h1>{accessoryMode && <p class="catalog-lede">Encuentra accesorios para complementar, proteger y mantener tus instrumentos.</p>}</header>
	<div class="catalog-toolbar"><button class="mobile-filter-toggle" type="button" data-open-filters>Filtrar productos <i class="ph-bold ph-sliders-horizontal" aria-hidden="true"></i></button><p data-result-count>Mostrando {products.length} productos</p><label class="sort-control">Ordenar por <select data-sort><option value="relevance">Relevancia</option><option value="low">Precio: menor a mayor</option><option value="high">Precio: mayor a menor</option><option value="newest">Novedades</option></select></label></div>
	<div class="catalog-layout"><CatalogFilters filters={category.filters} brands={category.brands} types={category.types} {minPrice} {maxPrice} {accessoryMode} /><section class="catalog-results" aria-label={`Resultados de ${category.title.toLowerCase()}`}><div class="catalog-grid" data-product-grid>{products.map((product, index) => <CatalogCard product={product} metaKeys={accessoryMode ? ['instrumento'] : category.filters.map((filter) => filter.key)} productUrl={productDetailUrl(product)} whatsappUrl={whatsappLink(`${product.brand} ${product.model}`)} useUnicorn={index < 12} />)}</div><div class="catalog-empty" data-empty-state hidden><h2>{accessoryMode ? 'No encontramos accesorios que coincidan con estos filtros.' : 'No encontramos productos con estos filtros.'}</h2><p>Prueba limpiando los filtros para ver toda la selección.</p><button type="button" data-clear-filters>Limpiar filtros</button></div></section></div>
</main>

<script>
	const page = document.querySelector<HTMLElement>('.catalog-page');
	if (page) {
		const cards = [...page.querySelectorAll<HTMLElement>('[data-product]')];
		const panel = page.querySelector<HTMLElement>('[data-filter-panel]');
		const count = page.querySelector<HTMLElement>('[data-result-count]');
		const empty = page.querySelector<HTMLElement>('[data-empty-state]');
		const grid = page.querySelector<HTMLElement>('[data-product-grid]');
		const sort = page.querySelector<HTMLSelectElement>('[data-sort]');
		const minInput = page.querySelector<HTMLInputElement>('input[name="minPrice"]');
		const maxInput = page.querySelector<HTMLInputElement>('input[name="maxPrice"]');
		const minRange = page.querySelector<HTMLInputElement>('[data-price-min]');
		const maxRange = page.querySelector<HTMLInputElement>('[data-price-max]');
		const apply = page.querySelector<HTMLButtonElement>('[data-apply-filters]');
		const selected = (name: string) => [...page.querySelectorAll<HTMLInputElement>(`input[name="${name}"]:checked`)].map((input) => input.value);
		const update = () => {
			const active = [...new Set([...page.querySelectorAll<HTMLInputElement>('input[type="checkbox"]')].map((input) => input.name))].map((key) => [key, selected(key)] as const);
			const min = Number(page.querySelector<HTMLInputElement>('input[name="minPrice"]')?.value || 0);
			const max = Number(page.querySelector<HTMLInputElement>('input[name="maxPrice"]')?.value || Number.POSITIVE_INFINITY);
			const visible = cards.filter((card) => { const values = JSON.parse(card.dataset.filters ?? '{}') as Record<string, string | string[]>; return Number(card.dataset.price) >= min && Number(card.dataset.price) <= max && active.every(([key, options]) => { const value = values[key]; return options.length === 0 || (Array.isArray(value) ? value.some((item) => options.includes(item)) : options.includes(value ?? '')); }); });
			cards.forEach((card) => card.hidden = !visible.includes(card));
			visible.sort((a, b) => sort?.value === 'low' ? Number(a.dataset.price) - Number(b.dataset.price) : sort?.value === 'high' ? Number(b.dataset.price) - Number(a.dataset.price) : sort?.value === 'newest' ? String(b.dataset.date).localeCompare(String(a.dataset.date)) : 0).forEach((card) => grid?.append(card));
			if (count) count.textContent = `Mostrando ${visible.length} ${visible.length === 1 ? 'producto' : 'productos'}`;
			if (apply) apply.textContent = `Ver ${visible.length} ${visible.length === 1 ? 'producto' : 'productos'}`;
			if (empty) empty.hidden = visible.length !== 0;
		};
		const syncPrice = (source: 'min' | 'max') => {
			if (!minInput || !maxInput || !minRange || !maxRange) return;
			let min = Number(minInput.value || minRange.min);
			let max = Number(maxInput.value || maxRange.max);
			if (source === 'min' && min > max) max = min;
			if (source === 'max' && max < min) min = max;
			minInput.value = String(min); maxInput.value = String(max); minRange.value = String(min); maxRange.value = String(max);
			update();
		};
		page.querySelectorAll<HTMLInputElement>('input').forEach((input) => input.addEventListener('input', update));
		minInput?.addEventListener('input', () => syncPrice('min'));
		maxInput?.addEventListener('input', () => syncPrice('max'));
		minRange?.addEventListener('input', () => { if (minInput) minInput.value = minRange.value; syncPrice('min'); });
		maxRange?.addEventListener('input', () => { if (maxInput) maxInput.value = maxRange.value; syncPrice('max'); });
		sort?.addEventListener('change', update);
		page.querySelectorAll<HTMLButtonElement>('[data-clear-filters]').forEach((button) => button.addEventListener('click', () => { page.querySelectorAll<HTMLInputElement>('input[type="checkbox"]').forEach((input) => input.checked = false); if (minInput) minInput.value = minInput.min; if (maxInput) maxInput.value = maxInput.max; if (minRange) minRange.value = minRange.min; if (maxRange) maxRange.value = maxRange.max; if (sort) sort.value = 'relevance'; update(); }));
		page.querySelectorAll<HTMLButtonElement>('[data-filter-accordion]').forEach((button) => button.addEventListener('click', () => { const content = document.getElementById(button.getAttribute('aria-controls') ?? ''); const expanded = button.getAttribute('aria-expanded') === 'true'; button.setAttribute('aria-expanded', String(!expanded)); if (content) content.hidden = expanded; }));
		page.querySelector<HTMLButtonElement>('[data-open-filters]')?.addEventListener('click', () => panel?.classList.add('is-open'));
		page.querySelector<HTMLButtonElement>('[data-close-filters]')?.addEventListener('click', () => panel?.classList.remove('is-open'));
		apply?.addEventListener('click', () => { update(); panel?.classList.remove('is-open'); });
		const unicornHosts = [...page.querySelectorAll<HTMLElement>('[data-unicorn-card]')];
		if (unicornHosts.length && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
			const unicornWindow = window as Window & typeof globalThis & { UnicornStudio?: { init?: () => void; isInitialized?: boolean } };
			const initializeUnicorn = () => {
				if (unicornWindow.UnicornStudio?.init && !unicornWindow.UnicornStudio.isInitialized) {
					unicornWindow.UnicornStudio.init();
					unicornWindow.UnicornStudio.isInitialized = true;
				}
			};
			if (unicornWindow.UnicornStudio?.init) initializeUnicorn();
			else if (!document.querySelector('script[data-unicorn-studio]')) {
				const script = document.createElement('script');
				script.src = 'https://cdn.jsdelivr.net/gh/hiunicornstudio/unicornstudio.js@v1.4.29/dist/unicornStudio.umd.js';
				script.async = true;
				script.dataset.unicornStudio = 'true';
				script.onload = initializeUnicorn;
				document.head.append(script);
			}
		}
		update();
	}
</script>

<style is:global>
