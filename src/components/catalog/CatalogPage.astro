---
import type { CatalogCategory } from '../../data/catalog';
import { productsFor } from '../../data/catalog';
import CatalogCard from './CatalogCard.astro';
import CatalogFilters from './CatalogFilters.astro';
interface Props { category: CatalogCategory; whatsappNumber: string }
const { category, whatsappNumber } = Astro.props;
const products = productsFor(category);
const whatsappLink = (product: string) => {
	const text = encodeURIComponent(`Hola Mozart, quiero consultar por ${product}.`);
	return whatsappNumber ? `https://wa.me/${whatsappNumber}?text=${text}` : `https://wa.me/?text=${text}`;
};
---
<main class="catalog-page">
	<header class="catalog-header"><p class="breadcrumb"><a href="/">Inicio</a><i class="ph-bold ph-caret-right" aria-hidden="true"></i><a href={`/${category.group}`}>{category.group === 'audio' ? 'Audio' : 'Instrumentos'}</a><i class="ph-bold ph-caret-right" aria-hidden="true"></i><strong>{category.title}</strong></p><h1>{category.title}</h1></header>
	<div class="catalog-toolbar"><button class="mobile-filter-toggle" type="button" data-open-filters>Filtrar productos <i class="ph-bold ph-sliders-horizontal" aria-hidden="true"></i></button><p data-result-count>Mostrando {products.length} productos</p><label class="sort-control">Ordenar por <select data-sort><option value="relevance">Relevancia</option><option value="low">Precio: menor a mayor</option><option value="high">Precio: mayor a menor</option><option value="newest">Novedades</option></select></label></div>
	<div class="catalog-layout"><CatalogFilters filters={category.filters} brands={category.brands} types={category.types} /><section class="catalog-results" aria-label={`Resultados de ${category.title.toLowerCase()}`}><div class="catalog-grid" data-product-grid>{products.map((product) => <CatalogCard product={product} metaKeys={category.filters.map((filter) => filter.key)} whatsappUrl={whatsappLink(`${product.brand} ${product.model}`)} />)}</div><div class="catalog-empty" data-empty-state hidden><h2>No encontramos productos con esos filtros.</h2><p>Prueba limpiando los filtros para ver toda la selección.</p><button type="button" data-clear-filters>Limpiar filtros</button></div></section></div>
</main>

<script>
	const page = document.querySelector<HTMLElement>('.catalog-page');
	if (page) {
		const cards = [...page.querySelectorAll<HTMLElement>('[data-product]')];
		const panel = page.querySelector<HTMLElement>('[data-filter-panel]');
		const count = page.querySelector<HTMLElement>('[data-result-count]');
		const empty = page.querySelector<HTMLElement>('[data-empty-state]');
		const grid = page.querySelector<HTMLElement>('[data-product-grid]');
		const sort = page.querySelector<HTMLSelectElement>('[data-sort]');
		const selected = (name: string) => [...page.querySelectorAll<HTMLInputElement>(`input[name="${name}"]:checked`)].map((input) => input.value);
		const update = () => {
			const active = [...new Set([...page.querySelectorAll<HTMLInputElement>('input[type="checkbox"]')].map((input) => input.name))].map((key) => [key, selected(key)] as const);
			const min = Number(page.querySelector<HTMLInputElement>('input[name="minPrice"]')?.value || 0);
			const max = Number(page.querySelector<HTMLInputElement>('input[name="maxPrice"]')?.value || Number.POSITIVE_INFINITY);
			const visible = cards.filter((card) => { const values = JSON.parse(card.dataset.filters ?? '{}') as Record<string, string>; return Number(card.dataset.price) >= min && Number(card.dataset.price) <= max && active.every(([key, options]) => options.length === 0 || options.includes(values[key] ?? '')); });
			cards.forEach((card) => card.hidden = !visible.includes(card));
			visible.sort((a, b) => sort?.value === 'low' ? Number(a.dataset.price) - Number(b.dataset.price) : sort?.value === 'high' ? Number(b.dataset.price) - Number(a.dataset.price) : sort?.value === 'newest' ? String(b.dataset.date).localeCompare(String(a.dataset.date)) : 0).forEach((card) => grid?.append(card));
			if (count) count.textContent = `Mostrando ${visible.length} ${visible.length === 1 ? 'producto' : 'productos'}`;
			if (empty) empty.hidden = visible.length !== 0;
		};
		page.querySelectorAll<HTMLInputElement>('input').forEach((input) => input.addEventListener('input', update));
		sort?.addEventListener('change', update);
		page.querySelectorAll<HTMLButtonElement>('[data-clear-filters]').forEach((button) => button.addEventListener('click', () => { page.querySelectorAll<HTMLInputElement>('input').forEach((input) => { input.checked = false; input.value = ''; }); if (sort) sort.value = 'relevance'; update(); }));
		page.querySelector<HTMLButtonElement>('[data-open-filters]')?.addEventListener('click', () => panel?.classList.toggle('is-open'));
	}
</script>

<style is:global>
	.catalog-page{min-height:100vh;padding:120px 4vw 100px;background:#030712;color:#fff;font-family:'Geist',sans-serif}.catalog-header,.catalog-toolbar,.catalog-layout{width:min(1440px,100%);margin:auto}.breadcrumb{display:flex;gap:10px;align-items:center;margin:0 0 22px;color:#a1a1aa;font-size:.82rem}.breadcrumb a{color:#a1a1aa;text-decoration:none}.breadcrumb strong{color:#06b6d4;font-weight:600}.catalog-header h1{margin:0;font-size:clamp(3.5rem,7vw,7rem);line-height:.9;letter-spacing:-.08em}.catalog-toolbar{display:flex;align-items:center;justify-content:space-between;gap:20px;margin:58px auto 24px}.catalog-toolbar p{margin:0;color:#a1a1aa}.sort-control{display:flex;align-items:center;gap:12px;color:#a1a1aa;font-size:.82rem}.sort-control select{min-width:215px;padding:13px 16px;color:#fff;background:#18181b;border:1px solid #27272a;border-radius:8px;font:inherit}.mobile-filter-toggle{display:none}.catalog-layout{display:grid;grid-template-columns:330px minmax(0,1fr);gap:42px;align-items:start}.catalog-filters{position:sticky;top:88px;padding:18px;background:linear-gradient(145deg,#0d1524,#07101e);border:1px solid #172234;border-radius:3px}.filter-heading{display:flex;justify-content:space-between;align-items:center;margin:2px 0 16px}.filter-heading h2{margin:0;font-size:1rem;letter-spacing:-.02em}.filter-heading button,.catalog-empty button{padding:0;border:0;color:#06b6d4;background:transparent;font:600 .72rem 'JetBrains Mono',monospace;cursor:pointer}.filter-heading button{display:inline-flex;align-items:center;gap:5px}.catalog-filters details{margin:7px 0;border:1px solid #172234;border-radius:6px;background:rgba(3,7,18,.42)}.catalog-filters summary{display:flex;align-items:center;gap:13px;min-height:44px;padding:0 13px;color:#d9dde5;font-size:.8rem;list-style:none;cursor:pointer}.catalog-filters summary::-webkit-details-marker{display:none}.filter-caret{margin-left:auto;color:#a1a1aa;font-size:1rem;transition:transform .2s ease}.catalog-filters details[open] .filter-caret{transform:rotate(180deg)}.filter-icon{width:17px;color:#a8b8cf;font-size:1rem;text-align:center}.filter-options{padding:0 15px 12px;border-top:1px solid rgba(39,50,70,.7)}.catalog-filters label{display:flex;align-items:center;gap:10px;margin:10px 0;color:#a1a1aa;font-size:.82rem;cursor:pointer}.filter-option input[type="checkbox"]{position:absolute;width:1px;height:1px;opacity:0}.checkbox-ui{display:grid;width:18px;height:18px;place-items:center;color:#fff;background:#07101e;border:1px solid #536276;border-radius:4px;transition:background .18s ease,border-color .18s ease,transform .18s ease}.checkbox-ui i{font-size:.78rem;opacity:0;transform:scale(.7);transition:opacity .18s ease,transform .18s ease}.filter-option:has(input:checked) .checkbox-ui{background:#4f46e5;border-color:#818cf8}.filter-option:has(input:checked) .checkbox-ui i{opacity:1;transform:scale(1)}.filter-option:has(input:focus-visible) .checkbox-ui{outline:2px solid #06b6d4;outline-offset:3px}.price-inputs{display:grid;grid-template-columns:1fr 1fr;gap:10px}.price-inputs label{display:block;font-size:.74rem}.price-inputs input{width:100%;margin-top:7px;padding:9px;color:#fff;background:#030712;border:1px solid #27272a;border-radius:4px;font:inherit}.catalog-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}.catalog-card{overflow:hidden;background:#18181b;border:1px solid #27272a;border-radius:10px;transition:transform .25s ease,border-color .25s ease}.catalog-card:hover{transform:translateY(-4px);border-color:#4f46e5}.catalog-card[hidden]{display:none}.catalog-image{position:relative;height:290px;overflow:hidden;background:#030712}.catalog-image img{width:100%;height:100%;object-fit:cover;filter:contrast(1.05);transition:transform .7s ease}.catalog-card:hover .catalog-image img{transform:scale(1.05)}.stock{position:absolute;top:14px;left:14px;padding:6px 8px;color:#a1a1aa;background:rgba(3,7,18,.76);border:1px solid #27272a;border-radius:5px;font:600 .66rem 'JetBrains Mono',monospace}.stock.in-stock{color:#06b6d4;border-color:rgba(6,182,212,.6)}.catalog-card-content{padding:17px}.catalog-brand{margin:0 0 5px;color:#06b6d4;font:600 .7rem 'JetBrains Mono',monospace;text-transform:uppercase}.catalog-card h2{margin:0;font-size:1.35rem;letter-spacing:-.05em}.catalog-meta{min-height:38px;margin:8px 0;color:#a1a1aa;font-size:.78rem;line-height:1.4}.catalog-price{margin:0 0 14px;font-size:1.25rem;font-weight:700;letter-spacing:-.04em}.catalog-card-content a{display:flex;align-items:center;justify-content:space-between;padding:11px 12px;color:#fff;background:#4f46e5;border-radius:6px;font-size:.75rem;font-weight:600;text-decoration:none}.catalog-empty{padding:90px 20px;text-align:center;border:1px dashed #27272a;border-radius:10px}.catalog-empty h2{margin:0 0 10px;font-size:1.5rem}.catalog-empty p{margin:0 0 20px;color:#a1a1aa}@media(max-width:1000px){.catalog-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:760px){.catalog-page{padding:96px 5vw 64px}.catalog-toolbar{flex-wrap:wrap;margin-top:38px}.catalog-toolbar p{order:3;width:100%}.sort-control{flex:1;justify-content:space-between}.sort-control select{min-width:0;flex:1}.mobile-filter-toggle{display:inline-flex;align-items:center;gap:8px;padding:12px 14px;color:#fff;background:#18181b;border:1px solid #27272a;border-radius:7px;font:600 .78rem 'JetBrains Mono',monospace}.catalog-layout{display:block}.catalog-filters{display:none;position:static;margin-bottom:18px}.catalog-filters.is-open{display:block}.catalog-grid{grid-template-columns:1fr;gap:14px}.catalog-image{height:340px}}

	.catalog-card{
		background:
			radial-gradient(circle at 96% 108%,rgba(166,72,42,.52),transparent 48%),
			linear-gradient(155deg,#302e2d 0%,#292625 54%,#392721 100%);
		border-color:rgba(210,139,104,.28);
		border-radius:16px;
		box-shadow:inset 0 1px 0 rgba(255,244,235,.1),0 18px 42px rgba(72,32,22,.24);
		transition:transform .28s cubic-bezier(.16,1,.3,1),border-color .28s ease,box-shadow .28s ease;
	}
	.catalog-card:hover{border-color:rgba(220,144,105,.58);box-shadow:inset 0 1px 0 rgba(255,244,235,.14),0 24px 52px rgba(91,40,26,.3)}
	.catalog-image{height:280px;margin:10px 10px 0;border:1px solid rgba(255,244,235,.14);border-radius:12px;background:#d4cec6}
	.catalog-image img{filter:contrast(1.04) saturate(.88)}
	.catalog-card:hover .catalog-image img{transform:scale(1.045);filter:contrast(1.04) saturate(1)}
	.catalog-card-content{display:flex;min-height:178px;flex-direction:column;padding:18px 20px 20px}
	.catalog-brand{margin:0 0 8px;color:#e6b69f}
	.stock{position:absolute;z-index:1;top:14px;left:14px;padding:7px 9px;color:#d0cbc8;background:rgba(43,36,32,.86);border:1px solid rgba(235,190,166,.28);border-radius:7px;font-size:.62rem;line-height:1;backdrop-filter:blur(10px)}
	.stock.in-stock{color:#d8eadc;background:rgba(34,51,41,.86);border-color:rgba(185,216,195,.34)}
	.stock.on-order{color:#edc79f}
	.stock.sold-out{color:#bdb5b1}
	.catalog-card h2{font-size:1.45rem;line-height:1.05}
	.catalog-meta{min-height:0;margin:9px 0 18px;color:#d2cbc7}
	.catalog-card-footer{display:flex;align-items:flex-end;justify-content:space-between;gap:16px;margin-top:auto}
	.catalog-price{margin:0;color:#f5eee9;font-size:clamp(1.4rem,2vw,1.85rem);line-height:1;font-weight:700}
	.catalog-card-content .catalog-whatsapp-cta{display:flex;width:50px;height:50px;flex:0 0 50px;align-items:center;justify-content:center;padding:0;color:#2d2724;background:#f2eae4;border:1px solid rgba(255,255,255,.36);border-radius:12px;box-shadow:inset 0 1px 0 rgba(255,255,255,.6),0 8px 18px rgba(72,32,22,.18);line-height:1;transition:transform .2s cubic-bezier(.16,1,.3,1),background .2s ease,box-shadow .2s ease}
	.catalog-whatsapp-cta i{display:block;width:1em;height:1em;font-size:1.55rem;line-height:1;text-align:center}
	.catalog-whatsapp-cta i::before{display:block}
	.catalog-card-content .catalog-whatsapp-cta:hover{color:#2c211d;background:#e3a080;box-shadow:inset 0 1px 0 rgba(255,255,255,.42),0 10px 22px rgba(98,43,27,.25);transform:translateY(-2px)}
	.catalog-card-content .catalog-whatsapp-cta:focus-visible{outline:2px solid #e3a080;outline-offset:3px}
	.catalog-card-content .catalog-whatsapp-cta:active{transform:scale(.98)}
	@media(max-width:760px){.catalog-image{height:330px}.catalog-card-content{min-height:178px}}
	@media(prefers-reduced-motion:reduce){.catalog-card,.catalog-image img,.catalog-whatsapp-cta{transition:none!important}.catalog-card:hover,.catalog-card:hover .catalog-image img,.catalog-card-content .catalog-whatsapp-cta:hover{transform:none}}
</style>
