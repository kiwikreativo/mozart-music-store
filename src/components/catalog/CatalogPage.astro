	/* Unified catalog filter — shared by every category listing. */
	.catalog-layout{grid-template-columns:336px minmax(0,1fr);gap:36px}
	.catalog-filters{box-sizing:border-box;position:sticky;top:88px;max-height:calc(100vh - 112px);overflow:auto;padding:24px;background:var(--filter-background);border:1px solid var(--filter-border);border-radius:26px;color:var(--filter-text-primary);box-shadow:none;transition:background-color .18s ease,border-color .18s ease,color .18s ease}
