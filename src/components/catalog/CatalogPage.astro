ilter-caret{transform:rotate(180deg)}.filter-icon{width:17px;color:#a8b8cf;font-size:1rem;text-align:center}.filter-options{padding:0 15px 12px;border-top:1px solid rgba(39,50,70,.7)}.catalog-filters label{display:flex;align-items:center;gap:10px;margin:10px 0;color:#a1a1aa;font-size:.82rem;cursor:pointer}.filter-option input[type="checkbox"]{position:absolute;width:1px;height:1px;opacity:0}.checkbox-ui{display:grid;width:18px;height:18px;place-items:center;color:#fff;background:#07101e;border:1px solid #536276;border-radius:4px;transition:background .18s ease,border-color .18s ease,transform .18s ease}.checkbox-ui i{font-size:.78rem;opacity:0;transform:scale(.7);transition:opacity .18s ease,transform .18s ease}.filter-option:has(input:checked) .checkbox-ui{background:#4f46e5;border-color:#818cf8}.filter-option:has(input:checked) .checkbox-ui i{opacity:1;transform:scale(1)}.filter-option:has(input:focus-visible) .checkbox-ui{outline:2px solid #06b6d4;outline-offset:3px}.price-inputs{display:grid;grid-template-columns:1fr 1fr;gap:10px}.price-inputs label{display:block;font-size:.74rem}.price-inputs input{width:100%;margin-top:7px;padding:9px;color:#fff;background:#030712;border:1px solid #27272a;border-radius:4px;font:inherit}.catalog-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}.catalog-card{overflow:hidden;background:#18181b;border:1px solid #27272a;border-radius:10px;transition:transform .25s ease,border-color .25s ease}.catalog-card:hover{transform:translateY(-4px);border-color:#4f46e5}.catalog-card[hidden]{display:none}.catalog-image{position:relative;height:290px;overflow:hidden;background:#030712}.catalog-image img{width:100%;height:100%;object-fit:cover;filter:contrast(1.05);transition:transform .7s ease}.catalog-card:hover .catalog-image img{transform:scale(1.05)}.stock{position:absolute;top:14px;left:14px;padding:6px 8px;color:#a1a1aa;background:rgba(3,7,18,.76);border:1px solid #27272a;border-radius:5px;font:600 .66rem 'JetBrains Mono',monospace}.stock.in-stock{color:#06b6d4;border-color:rgba(6,182,212,.6)}.catalog-card-content{padding:17px}.catalog-brand{margin:0 0 5px;color:#06b6d4;font:600 .7rem 'JetBrains Mono',monospace;text-transform:uppercase}.catalog-card h2{margin:0;font-size:1.35rem;letter-spacing:-.05em}.catalog-meta{min-height:38px;margin:8px 0;color:#a1a1aa;font-size:.78rem;line-height:1.4}.catalog-price{margin:0 0 14px;font-size:1.25rem;font-weight:700;letter-spacing:-.04em}.catalog-card-content a{display:flex;align-items:center;justify-content:space-between;padding:11px 12px;color:#fff;background:#4f46e5;border-radius:6px;font-size:.75rem;font-weight:600;text-decoration:none}.catalog-empty{padding:90px 20px;text-align:center;border:1px dashed #27272a;border-radius:10px}.catalog-empty h2{margin:0 0 10px;font-size:1.5rem}.catalog-empty p{margin:0 0 20px;color:#a1a1aa}@media(max-width:1000px){.catalog-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:760px){.catalog-page{padding:96px 5vw 64px}.catalog-toolbar{flex-wrap:wrap;margin-top:38px}.catalog-toolbar p{order:3;width:100%}.sort-control{flex:1;justify-content:space-between}.sort-control select{min-width:0;flex:1}.mobile-filter-toggle{display:inline-flex;align-items:center;gap:8px;padding:12px 14px;color:#fff;background:#18181b;border:1px solid #27272a;border-radius:7px;font:600 .78rem 'JetBrains Mono',monospace}.catalog-layout{display:block}.catalog-filters{display:none;position:static;margin-bottom:18px}.catalog-filters.is-open{display:block}.catalog-grid{grid-template-columns:1fr;gap:14px}.catalog-image{height:340px}}

	.catalog-card{
