			radial-gradient(circle at 96% 108%,rgba(166,72,42,.52),transparent 48%),
			linear-gradient(155deg,#302e2d 0%,#292625 54%,#392721 100%);
		border-color:rgba(210,139,104,.28);
		border-radius:16px;
		box-shadow:inset 0 1px 0 rgba(255,244,235,.1),0 18px 42px rgba(72,32,22,.24);
		transition:transform .28s cubic-bezier(.16,1,.3,1),border-color .28s ease,box-shadow .28s ease;
	}
	.catalog-card{position:relative}
	.catalog-card-link{position:absolute;inset:0;z-index:1;border-radius:16px}
	.catalog-card-link:focus-visible{outline:3px solid #06b6d4;outline-offset:5px}
	.catalog-image,.catalog-card-content{position:relative;z-index:0;pointer-events:none}
	.catalog-card-content .catalog-whatsapp-cta{position:relative;z-index:2;pointer-events:auto}
