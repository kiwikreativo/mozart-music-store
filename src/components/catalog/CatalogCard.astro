---
import type { CatalogProduct } from '../../data/catalog';
interface Props { product: CatalogProduct; whatsappUrl: string; metaKeys: string[] }
const { product, whatsappUrl, metaKeys } = Astro.props;
const price = new Intl.NumberFormat('es-CR', { style: 'currency', currency: 'CRC', maximumFractionDigits: 0 }).format(product.price);
const filters = JSON.stringify({ type: product.type, brand: product.brand, availability: product.availability, level: product.level, ...product.attributes });
---
<article class="catalog-card" data-product data-price={product.price} data-date={product.date} data-filters={filters}>
	<div class="catalog-image">
		<img src={product.image} alt={`${product.brand} ${product.model}`} loading="lazy" />
		<span class:list={['stock', product.availability === 'Disponible' && 'in-stock', product.availability === 'Por encargo' && 'on-order', product.availability === 'Agotado' && 'sold-out']}>{product.availability}</span>
	</div>
	<div class="catalog-card-content">
		<p class="catalog-brand">{product.brand}</p>
		<h2>{product.model}</h2>
		<p class="catalog-meta">{[product.type, ...metaKeys.map((key) => product.attributes[key]).filter(Boolean)].join(' · ')}</p>
		<div class="catalog-card-footer">
			<p class="catalog-price">{price}</p>
			<a class="catalog-whatsapp-cta" href={whatsappUrl} target="_blank" rel="noreferrer" aria-label={`Consultar por ${product.brand} ${product.model} en WhatsApp`} title={`Consultar por ${product.brand} ${product.model} en WhatsApp`}><i class="ph-bold ph-whatsapp-logo" aria-hidden="true"></i></a>
		</div>
	</div>
</article>
