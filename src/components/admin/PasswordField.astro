---
const { name, label, autocomplete = 'new-password' } = Astro.props;
const visibilityLabel = name === 'confirm' ? 'confirmación de contraseña' : label.toLowerCase();
---
<div class="auth-field">
  <label for={name}>{label} <span aria-hidden="true">*</span></label>
  <div class="password-control">
    <input id={name} name={name} type="password" required maxlength="128" autocomplete={autocomplete} aria-describedby={`${name}-error`} />
    <button type="button" data-password-toggle={name} data-label={visibilityLabel} aria-label={`Mostrar ${visibilityLabel}`} aria-pressed="false"><i class="ph-bold ph-eye" aria-hidden="true"></i></button>
  </div>
  <p class="field-error" id={`${name}-error`} hidden></p>
</div>
