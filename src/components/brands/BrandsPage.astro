---
import { brandGroups } from '../../data/brands';
import BrandCell from './BrandCell.astro';
interface Props { whatsappNumber: string }
const { whatsappNumber } = Astro.props;
const whatsappLink = (brand: string) => {
	const text = encodeURIComponent(`Hola Mozart, quiero consultar por productos de ${brand}.`);
	return whatsappNumber ? `https://wa.me/${whatsappNumber}?text=${text}` : `https://wa.me/?text=${text}`;
};
---
<main class="brands-page">
	<header class="brands-intro">
		<p class="brands-breadcrumb"><a href="/">Inicio</a><i class="ph-bold ph-caret-right" aria-hidden="true"></i><strong>Marcas</strong></p>
		<p class="brands-kicker">Marcas que conocemos</p>
		<h1>Elige tu próximo<br />sonido con <em>confianza.</em></h1>
		<p class="brands-lede">En Mozart reunimos marcas confiables para músicos, audio en casa, sonido en vivo y producción musical.</p>
	</header>

	<div class="brand-groups">
		{brandGroups.map((group) => (
			<section class="brand-group" aria-labelledby={`brand-group-${group.title}`}>
				<div class="brand-group-heading"><i class:list={['ph-bold', group.icon]} aria-hidden="true"></i><h2 id={`brand-group-${group.title}`}>{group.title}</h2></div>
				<div class="brand-grid">{group.brands.map((brand) => <BrandCell brand={brand} whatsappUrl={whatsappLink(brand.name)} />)}</div>
			</section>
		))}
	</div>
</main>

<style is:global>
	.brands-page{min-height:100vh;padding:120px 4vw 108px;background:#030712;color:#fff;font-family:'Geist',sans-serif}.brands-intro,.brand-groups{width:min(1280px,100%);margin:auto}.brands-intro{max-width:1280px;padding:5.5vh 0 11vh}.brands-breadcrumb{display:flex;align-items:center;gap:10px;margin:0 0 46px;color:#a1a1aa;font-size:.82rem}.brands-breadcrumb a{color:inherit;text-decoration:none}.brands-breadcrumb strong{color:#06b6d4;font-weight:600}.brands-kicker{margin:0 0 21px;color:#06b6d4;font:600 .7rem 'JetBrains Mono',monospace;letter-spacing:.13em;text-transform:uppercase}.brands-intro h1{max-width:820px;margin:0;font-size:clamp(3.5rem,7vw,7.4rem);font-weight:800;letter-spacing:-.082em;line-height:.88}.brands-intro em{color:#06b6d4;font-family:Georgia,serif;font-weight:400}.brands-lede{max-width:560px;margin:34px 0 0;color:#a1a1aa;font-size:1.05rem;line-height:1.55}.brand-groups{display:grid;gap:70px}.brand-group-heading{display:flex;align-items:center;gap:12px;margin-bottom:17px}.brand-group-heading i{color:#06b6d4;font-size:1.1rem}.brand-group-heading h2{margin:0;font-size:1rem;letter-spacing:-.04em}.brand-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));border-top:1px solid #27272a;border-left:1px solid #27272a}.brand-cell{display:flex;min-height:218px;flex-direction:column;align-items:flex-start;padding:25px 23px 21px;background:#0a101d;border-right:1px solid #27272a;border-bottom:1px solid #27272a;transition:background .25s ease,transform .25s ease}.brand-cell:hover{background:#111b2d;transform:translateY(-3px)}.brand-cell h3{margin:0;color:#fff;font-size:clamp(1.45rem,2.15vw,2rem);letter-spacing:-.07em;line-height:1}.brand-cell p{margin:18px 0 22px;color:#a1a1aa;font-size:.82rem;line-height:1.45}.brand-cell a{display:inline-flex;align-items:center;gap:8px;margin-top:auto;color:#06b6d4;font:600 .68rem 'JetBrains Mono',monospace;letter-spacing:.05em;text-decoration:none;text-transform:uppercase}.brand-cell a:hover{color:#fff}.brand-cell a:focus-visible,.brands-breadcrumb a:focus-visible{outline:2px solid #06b6d4;outline-offset:4px}@media(max-width:1000px){.brand-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:760px){.brands-page{padding:96px 5vw 68px}.brands-intro{padding:5vh 0 9vh}.brands-breadcrumb{margin-bottom:34px}.brands-intro h1{font-size:clamp(3.15rem,16vw,5.4rem)}.brands-lede{margin-top:27px;font-size:1rem}.brand-groups{gap:52px}.brand-grid{grid-template-columns:1fr}.brand-cell{min-height:190px;padding:24px 21px}.brand-cell h3{font-size:2rem}}
</style>
