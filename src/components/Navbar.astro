---
interface Props { whatsappUrl: string }
const { whatsappUrl } = Astro.props;

import { catalogCategories } from '../data/catalog';
const instruments = catalogCategories.filter((category) => category.group === 'instrumentos');
const audio = catalogCategories.filter((category) => category.group === 'audio');
---

<header class="navbar" data-navbar>
	<div class="navbar-shell">
		<a class="navbar-brand" href="#inicio" aria-label="Mozart inicio">MOZART<span>®</span></a>
		<nav class="navbar-links" aria-label="Navegación principal">
			<div class="navbar-menu">
				<button class="navbar-trigger" type="button" aria-expanded="false" aria-controls="menu-instrumentos" data-menu-trigger="instrumentos">Instrumentos <i class="ph-bold ph-caret-down" aria-hidden="true"></i></button>
				<div id="menu-instrumentos" class="navbar-dropdown" data-menu="instrumentos" hidden>
					{instruments.map((item) => <a href={`/${item.group}/${item.slug}`}>{item.title}</a>)}
				</div>
			</div>
			<div class="navbar-menu">
				<button class="navbar-trigger" type="button" aria-expanded="false" aria-controls="menu-audio" data-menu-trigger="audio">Audio <i class="ph-bold ph-caret-down" aria-hidden="true"></i></button>
				<div id="menu-audio" class="navbar-dropdown" data-menu="audio" hidden>
					{audio.map((item) => <a href={`/${item.group}/${item.slug}`}>{item.title}</a>)}
				</div>
			</div>
			<a class="navbar-link" href="/marcas">Marcas</a>
		</nav>
		<a class="navbar-whatsapp" href={whatsappUrl} target="_blank" rel="noreferrer">WhatsApp <i class="ph-bold ph-whatsapp-logo" aria-hidden="true"></i></a>
		<button class="navbar-toggle" type="button" aria-expanded="false" aria-controls="navbar-mobile-menu" aria-label="Abrir menú" data-mobile-toggle><i class="ph-bold ph-list" aria-hidden="true"></i></button>
	</div>
	<div id="navbar-mobile-menu" class="navbar-mobile" hidden data-mobile-menu>
		<div class="mobile-group"><button type="button" aria-expanded="false" data-mobile-submenu="instrumentos">Instrumentos <i class="ph-bold ph-caret-down" aria-hidden="true"></i></button><div data-mobile-panel="instrumentos" hidden>{instruments.map((item) => <a href={`/${item.group}/${item.slug}`}>{item.title}</a>)}</div></div>
		<div class="mobile-group"><button type="button" aria-expanded="false" data-mobile-submenu="audio">Audio <i class="ph-bold ph-caret-down" aria-hidden="true"></i></button><div data-mobile-panel="audio" hidden>{audio.map((item) => <a href={`/${item.group}/${item.slug}`}>{item.title}</a>)}</div></div>
		<a href="/marcas">Marcas</a>
		<a class="mobile-whatsapp" href={whatsappUrl} target="_blank" rel="noreferrer">Contactar por WhatsApp <i class="ph-bold ph-whatsapp-logo" aria-hidden="true"></i></a>
	</div>
</header>

<script>
	const navbar = document.querySelector<HTMLElement>('[data-navbar]');
	if (navbar) {
		const closeDesktopMenus = () => navbar.querySelectorAll<HTMLElement>('[data-menu]').forEach((menu) => {
			menu.hidden = true;
			const trigger = navbar.querySelector<HTMLButtonElement>(`[data-menu-trigger="${menu.dataset.menu}"]`);
			trigger?.setAttribute('aria-expanded', 'false');
		});
		navbar.querySelectorAll<HTMLButtonElement>('[data-menu-trigger]').forEach((trigger) => trigger.addEventListener('click', () => {
			const menu = navbar.querySelector<HTMLElement>(`[data-menu="${trigger.dataset.menuTrigger}"]`);
			const willOpen = menu?.hidden;
			closeDesktopMenus();
			if (menu && willOpen) { menu.hidden = false; trigger.setAttribute('aria-expanded', 'true'); }
		}));
		const mobileToggle = navbar.querySelector<HTMLButtonElement>('[data-mobile-toggle]');
		const mobileMenu = navbar.querySelector<HTMLElement>('[data-mobile-menu]');
		mobileToggle?.addEventListener('click', () => { const willOpen = mobileMenu?.hidden; if (mobileMenu) mobileMenu.hidden = !willOpen; mobileToggle.setAttribute('aria-expanded', String(willOpen)); mobileToggle.setAttribute('aria-label', willOpen ? 'Cerrar menú' : 'Abrir menú'); mobileToggle.querySelector('i')?.classList.toggle('ph-list', !willOpen); mobileToggle.querySelector('i')?.classList.toggle('ph-x', Boolean(willOpen)); });
		navbar.querySelectorAll<HTMLButtonElement>('[data-mobile-submenu]').forEach((trigger) => trigger.addEventListener('click', () => {
			const panel = navbar.querySelector<HTMLElement>(`[data-mobile-panel="${trigger.dataset.mobileSubmenu}"]`);
			if (panel) { panel.hidden = !panel.hidden; trigger.setAttribute('aria-expanded', String(!panel.hidden)); }
		}));
		document.addEventListener('click', (event) => { if (!navbar.contains(event.target as Node)) closeDesktopMenus(); });
		document.addEventListener('keydown', (event) => { if (event.key === 'Escape') { closeDesktopMenus(); if (mobileMenu) mobileMenu.hidden = true; mobileToggle?.setAttribute('aria-expanded', 'false'); } });
	}
</script>

<style>
	.navbar { position: sticky; top: 12px; z-index: 50; width: min(1120px, calc(100% - 24px)); margin: 0 auto -80px; color: #fff; font-family: 'Geist', sans-serif; }
	.navbar-shell { min-height: 56px; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; padding: 8px 10px 8px 18px; background: rgba(3, 7, 18, .76); border: 1px solid rgba(255, 255, 255, .13); border-radius: 999px; box-shadow: 0 2px 6px rgba(0,0,0,.12), inset 0 1px 0 rgba(255,255,255,.12); backdrop-filter: blur(20px); }
	.navbar-brand { color: #fff; font-size: 1.05rem; font-weight: 700; letter-spacing: -.08em; text-decoration: none; }.navbar-brand span { font-size: .42em; vertical-align: top; margin-left: .08rem; }
	.navbar-links { display: flex; align-items: center; gap: 26px; }.navbar-menu { position: relative; }.navbar-trigger,.navbar-link { border: 0; padding: 8px 0; color: #d4d4d8; background: transparent; font: 500 .83rem/1 'Geist', sans-serif; text-decoration: none; cursor: pointer; transition: color .2s ease; }.navbar-trigger:hover,.navbar-link:hover { color: #fff; }.navbar-trigger i { display: inline-block; margin-left: 5px; transition: transform .2s ease; }.navbar-trigger[aria-expanded="true"] i { transform: rotate(180deg); }
	.navbar-dropdown { position: absolute; top: calc(100% + 16px); left: 50%; width: max-content; min-width: 242px; max-height: min(70vh, 530px); overflow-y: auto; padding: 12px 0; background: rgba(3,7,18,.96); border: 1px solid rgba(255,255,255,.14); border-radius: 10px; box-shadow: 0 18px 45px rgba(0,0,0,.38), inset 0 1px 0 rgba(255,255,255,.08); backdrop-filter: blur(20px); transform: translateX(-50%); }.navbar-dropdown a { display: block; padding: 9px 18px; color: #e4e4e7; font-size: .9rem; text-decoration: none; transition:color .2s ease,background .2s ease; }.navbar-dropdown a:hover { color:#fff; background: rgba(255,255,255,.08); }
	.navbar-whatsapp { justify-self: end; display: inline-flex; align-items: center; gap: 8px; padding: 10px 15px; color: #fff; background: linear-gradient(135deg, rgba(255,255,255,.15), rgba(255,255,255,.05)); border: 1px solid rgba(255,255,255,.2); border-radius: 999px; box-shadow: inset 1px 1px 1px rgba(255,255,255,.2), 0 4px 14px rgba(0,0,0,.16); font-size: .8rem; font-weight: 600; text-decoration: none; transition: transform .2s ease, background .2s ease; }.navbar-whatsapp:hover { transform: translateY(-2px); background: linear-gradient(135deg, rgba(255,255,255,.22), rgba(255,255,255,.08)); }.navbar-whatsapp:active { transform: scale(.98); }
	.navbar-toggle,.navbar-mobile { display: none; }.navbar a:focus-visible,.navbar button:focus-visible { outline: 2px solid #06b6d4; outline-offset: 3px; }
	@media (max-width: 760px) { .navbar { width: calc(100% - 20px); top: 10px; margin-bottom: -66px; }.navbar-shell { grid-template-columns: 1fr auto; min-height: 52px; }.navbar-links,.navbar-whatsapp { display: none; }.navbar-toggle { display: grid; width: 36px; height: 36px; place-content: center; color: #fff; border: 0; border-radius: 999px; background: rgba(255,255,255,.08); cursor: pointer; }.navbar-toggle i { font-size: 1.15rem; }.navbar-mobile { display: grid; gap: 2px; margin-top: 8px; padding: 10px; background: rgba(3,7,18,.94); border: 1px solid rgba(255,255,255,.13); border-radius: 16px; box-shadow: 0 18px 45px rgba(0,0,0,.28); backdrop-filter: blur(20px); }.navbar-mobile > a,.mobile-group > button,.mobile-group > div a { display: flex; justify-content: space-between; width: 100%; padding: 12px 10px; color: #fff; border: 0; background: transparent; font: 500 .95rem/1.2 'Geist',sans-serif; text-align: left; text-decoration: none; }.mobile-group > button { cursor: pointer; }.mobile-group > button i { transition: transform .2s ease; }.mobile-group > button[aria-expanded="true"] i { transform: rotate(180deg); }.mobile-group > div { padding: 0 6px 6px; }.mobile-group > div a { color: #a1a1aa; font-size: .87rem; }.mobile-whatsapp { margin-top: 6px; background: #4f46e5; border-radius: 10px; }.navbar-mobile[hidden] { display: none; } }
</style>
