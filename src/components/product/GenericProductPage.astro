---
import type { ProductDetail } from '../../data/productDetails';
import { getCatalogCategory } from '../../data/catalog';
interface Props { detail: ProductDetail; whatsappNumber: string }
const { detail, whatsappNumber } = Astro.props;
const { product } = detail;
const categoryTitle = getCatalogCategory(detail.group, detail.category)?.title ?? detail.category;
const price = new Intl.NumberFormat('es-CR', { style: 'currency', currency: 'CRC', maximumFractionDigits: 0 }).format(product.price);
const text = encodeURIComponent(`Hola Mozart, quiero consultar por ${product.brand} ${product.model}.`);
const whatsappUrl = whatsappNumber ? `https://wa.me/${whatsappNumber}?text=${text}` : `https://wa.me/?text=${text}`;
---
<main class="generic-product-page">
	<section class="generic-product-hero">
		<div><p class="product-breadcrumb"><a href="/">Inicio</a><i class="ph-bold ph-caret-right" aria-hidden="true"></i><a href={`/${detail.group}/${detail.category}`}>{categoryTitle}</a><i class="ph-bold ph-caret-right" aria-hidden="true"></i><strong>{product.model}</strong></p><p class="product-kicker">{product.brand} · {product.type}</p><h1>{product.model}</h1><p class="generic-lede">{detail.description}</p><div class="generic-offer"><strong>{price}</strong><span><i class="ph-bold ph-check-circle" aria-hidden="true"></i>{product.availability}</span></div><a class="product-cta" href={whatsappUrl} target="_blank" rel="noreferrer">Consultar por WhatsApp <i class="ph-bold ph-whatsapp-logo" aria-hidden="true"></i></a></div>
		<figure><img src={product.image} alt={`${product.brand} ${product.model}`} /></figure>
	</section>
	<section class="generic-product-section"><div class="generic-copy"><p class="product-kicker">Conoce el producto</p><h2>Hecho para<br /><em>tu próxima sesión.</em></h2><p>{detail.description}</p><a class="product-cta" href={whatsappUrl} target="_blank" rel="noreferrer">Consultar por WhatsApp <i class="ph-bold ph-whatsapp-logo" aria-hidden="true"></i></a></div><figure><img src={product.image} alt={`Detalle de ${product.brand} ${product.model}`} loading="lazy" /></figure></section>
	<section class="generic-specs"><p class="product-kicker">Ficha del producto</p><h2>Todo lo que<br /><em>necesitas saber.</em></h2><dl>{detail.specifications.map((spec) => <div><dt><i class:list={['ph-bold', spec.icon]} aria-hidden="true"></i>{spec.label}</dt><dd>{spec.value}</dd></div>)}</dl></section>
	<section class="product-final-cta"><h2>¿Listo para elegir?</h2><a href={whatsappUrl} target="_blank" rel="noreferrer">Consultar por WhatsApp <i class="ph-bold ph-whatsapp-logo" aria-hidden="true"></i></a></section>
</main>
<style is:global>
	.generic-product-page{background:var(--color-bg);color:var(--color-text);font-family:'Geist',sans-serif;overflow:hidden}.generic-product-hero,.generic-product-section,.generic-specs{width:min(1320px,90vw);margin:auto}.generic-product-hero{min-height:100svh;padding:138px 0 64px;display:grid;grid-template-columns:.85fr 1.15fr;align-items:center;gap:7vw}.generic-product-hero h1,.generic-product-page h2{margin:0;letter-spacing:-.075em;line-height:.92}.generic-product-hero h1{font-size:clamp(4rem,7vw,7rem)}.generic-product-hero figure{height:min(72vh,720px);margin:0;overflow:hidden;border-radius:72px 18px 18px;background:var(--color-surface-alt)}.generic-product-hero img,.generic-product-section figure img{width:100%;height:100%;object-fit:cover}.generic-lede{max-width:480px;margin:28px 0;color:var(--color-text-muted);line-height:1.55}.generic-offer{display:flex;align-items:center;gap:20px;margin-bottom:24px}.generic-offer strong{font-size:1.8rem}.generic-offer span{display:flex;align-items:center;gap:7px;color:var(--color-accent);font-weight:700;font-size:.82rem}.generic-product-section{padding:15vh 0;display:grid;grid-template-columns:.9fr 1.1fr;align-items:center;gap:8vw}.generic-copy>p:not(.product-kicker){max-width:450px;margin:28px 0;color:var(--color-text-muted);line-height:1.6}.generic-copy h2,.generic-specs h2{font-size:clamp(3.2rem,5.5vw,6rem)}.generic-copy figure{height:620px;margin:0;border-radius:20px;overflow:hidden}.generic-specs{padding:15vh 0}.generic-specs dl{max-width:780px;margin:50px 0 0}.generic-specs dl div{display:grid;grid-template-columns:1fr 1fr;gap:20px;padding:17px 0;border-bottom:1px solid var(--color-border)}.generic-specs dt{display:flex;align-items:center;gap:12px;font-weight:700}.generic-specs dt i{width:20px;color:var(--color-accent)}.generic-specs dd{margin:0;color:var(--color-text-muted)}.generic-product-page em{color:var(--color-accent);font:400 1em Georgia,serif}.generic-product-page .product-breadcrumb{display:flex;align-items:center;flex-wrap:wrap;gap:9px;margin:0 0 48px;color:var(--color-text-muted);font-size:.78rem}.generic-product-page .product-breadcrumb a{color:inherit;text-decoration:none}.generic-product-page .product-breadcrumb strong{color:var(--color-accent)}.generic-product-page .product-kicker{margin:0 0 18px;color:var(--color-accent);font:700 .7rem 'JetBrains Mono',monospace;letter-spacing:.13em;text-transform:uppercase}.generic-product-page .product-cta{display:inline-flex;align-items:center;justify-content:center;gap:12px;padding:14px 20px;color:#fff;background:linear-gradient(145deg,rgba(255,255,255,.18),rgba(255,255,255,.02) 55%),#4f46e5;border:1px solid rgba(255,255,255,.3);border-radius:16px;font-size:.82rem;font-weight:750;text-decoration:none;transition:transform .2s ease,filter .2s ease}.generic-product-page .product-cta:hover{filter:brightness(1.08);transform:translateY(-2px)}.generic-product-page .product-final-cta{display:flex;align-items:center;justify-content:space-between;gap:30px;padding:70px max(5vw,calc((100vw - 1320px)/2));color:#fff;background:#4f46e5}.generic-product-page .product-final-cta h2{font-size:clamp(2.8rem,6vw,6.5rem)}.generic-product-page .product-final-cta a{display:inline-flex;align-items:center;gap:12px;padding:16px 20px;color:#111827;background:#fff;border-radius:16px;font-weight:750;text-decoration:none}.generic-product-page a:focus-visible{outline:3px solid var(--color-focus);outline-offset:4px}@media(max-width:900px){.generic-product-hero{min-height:auto;padding:112px 0 60px;display:flex;flex-direction:column;align-items:stretch;gap:34px}.generic-product-hero>div{order:1}.generic-product-hero figure{order:2;height:115vw;max-height:560px;border-radius:34px 14px 14px}.generic-product-hero h1{font-size:clamp(3.5rem,15vw,5.3rem)}.generic-product-section{padding:11vh 0;display:flex;flex-direction:column;gap:38px}.generic-product-section figure{height:105vw;max-height:620px;order:-1}.generic-specs{padding:11vh 0}.generic-specs dl{margin-top:35px}.generic-product-page .product-final-cta{align-items:flex-start;flex-direction:column;padding:64px 5vw}.generic-product-page .product-final-cta a{width:100%;justify-content:center}}
</style>
