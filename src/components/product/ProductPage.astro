---
import type { ProductDetail } from '../../data/productDetails';
import ProductHero from './ProductHero.astro';
import ProductGallery from './ProductGallery.astro';
import ProductStory from './ProductStory.astro';
import ProductSpecs from './ProductSpecs.astro';
interface Props { detail: ProductDetail; whatsappNumber: string }
const { detail, whatsappNumber } = Astro.props;
const { product } = detail;
const price = new Intl.NumberFormat('es-CR', { style: 'currency', currency: 'CRC', maximumFractionDigits: 0 }).format(product.price);
const message = encodeURIComponent(`Hola Mozart, quiero consultar por ${product.brand} ${product.model}.`);
const whatsappUrl = whatsappNumber ? `https://wa.me/${whatsappNumber}?text=${message}` : `https://wa.me/?text=${message}`;
---
<main class="product-page" data-product-page>
	<ProductHero {detail} {price} {whatsappUrl} />
	<ProductGallery {detail} {price} {whatsappUrl} />
	<ProductStory {detail} />
	<ProductSpecs {detail} {whatsappUrl} />
</main>
<script>
	import { gsap } from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';
	const page = document.querySelector<HTMLElement>('[data-product-page]');
	if (page) {
		page.querySelectorAll<HTMLButtonElement>('[data-gallery-thumb]').forEach((button) => button.addEventListener('click', () => {
			const image = page.querySelector<HTMLImageElement>('[data-gallery-main]');
			if (image && button.dataset.src) { image.src = button.dataset.src; image.alt = button.dataset.alt ?? ''; }
			page.querySelectorAll<HTMLButtonElement>('[data-gallery-thumb]').forEach((thumb) => { thumb.classList.toggle('is-active', thumb === button); thumb.setAttribute('aria-pressed', String(thumb === button)); });
		}));
		const video = page.querySelector<HTMLVideoElement>('[data-product-video]');
		const play = page.querySelector<HTMLButtonElement>('[data-video-play]');
		play?.addEventListener('click', () => video?.play());
		video?.addEventListener('play', () => { if (play) play.hidden = true; });
		video?.addEventListener('pause', () => { if (play) play.hidden = false; });
		page.querySelectorAll<HTMLDetailsElement>('.product-feature-accordion details').forEach((item) => item.addEventListener('toggle', () => { if (item.open) page.querySelectorAll<HTMLDetailsElement>('.product-feature-accordion details').forEach((other) => { if (other !== item) other.open = false; }); }));
		if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
			gsap.registerPlugin(ScrollTrigger);
			gsap.utils.toArray<HTMLElement>('.product-reveal').forEach((element) => gsap.from(element, { y: 34, opacity: 0, duration: .8, ease: 'power3.out', scrollTrigger: { trigger: element, start: 'top 88%', once: true } }));
			const sticky = page.querySelector<HTMLElement>('.product-story-sticky');
			if (sticky && window.matchMedia('(min-width: 901px)').matches) gsap.to(sticky, { y: 80, ease: 'none', scrollTrigger: { trigger: '.product-story-layout', start: 'top 18%', end: 'bottom 80%', scrub: true } });
		}
	}
</script>
