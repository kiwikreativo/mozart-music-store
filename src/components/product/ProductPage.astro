---
import type { ProductDetail } from '../../data/productDetails';
interface Props { detail: ProductDetail; whatsappNumber: string }
const { detail, whatsappNumber } = Astro.props;
const { product } = detail;
const message = encodeURIComponent(`Hola Mozart, quiero consultar por ${product.brand} ${product.model}.`);
const whatsappUrl = whatsappNumber ? `https://wa.me/${whatsappNumber}?text=${message}` : `https://wa.me/?text=${message}`;
---
<main class="tw61" data-product-page>
 <section class="hero"><div class="aura" aria-hidden="true"><i></i><i></i><i></i></div><div class="wrap hero-in"><nav><a href="/">Inicio</a><b>/</b><a href="/instrumentos/guitarras">Guitarras</a><b>/</b><span>{product.model}</span></nav><p class="k">Tagima · guitarra eléctrica</p><h1>TW-61<br /><em>Jazz Red.</em></h1><p class="lede">Dos P-90, trémolo cromado y una voz con carácter propio.</p><figure><img src={detail.gallery[0].src} alt={detail.gallery[0].alt} fetchpriority="high" /></figure><a class="cta" href="#comprar">Ver instrumento <i class="ph-bold ph-arrow-down" aria-hidden="true"></i></a></div></section>
 <section id="comprar" class="buy wrap"><div class="gallery reveal"><div class="thumbs">{detail.gallery.map((media, index) => <button type="button" class:list={{ selected:index===0 }} aria-label={`Mostrar fotografía ${index + 1}`} aria-pressed={index === 0 ? 'true' : 'false'} data-thumb data-src={media.src} data-alt={media.alt}><img src={media.src} alt="" /></button>)}</div><figure><img src={detail.gallery[0].src} alt={detail.gallery[0].alt} data-main /></figure></div><div class="buy-copy reveal"><p class="k">Disponible en Mozart</p><h2>{product.brand}<br /><em>TW-61 Jazz Red</em></h2><p class="price">{detail.priceDisplay}</p><p class="reference">{detail.referencePrice}</p><p class="description">{detail.description}</p><div class="finish"><i></i><span><strong>Acabado</strong><small>Jazz Red</small></span></div><div class="facts"><span><i class="ph-bold ph-check-circle" aria-hidden="true"></i>1 unidad disponible</span><span><i class="ph-bold ph-shield-check" aria-hidden="true"></i>IVA incluido</span></div><a class="cta buy-cta" href={whatsappUrl} target="_blank" rel="noreferrer">Consultar por WhatsApp <i class="ph-bold ph-whatsapp-logo" aria-hidden="true"></i></a></div></section>
 <section class="intro"><div class="wrap"><p class="k">Diseñada para ser escuchada</p><h2>Una eléctrica con<br /><em>personalidad.</em></h2><p>La TW-61 reúne un cuerpo de álamo, un mástil de arce y una pareja de P-90 Tagima para construir tu propio punto de partida.</p></div></section>
 <section class="visual reveal"><img src={detail.gallery[1].src} alt={detail.gallery[1].alt} loading="lazy" /><div><p class="k">Jazz Red</p><strong>El color<br />entra primero.</strong></div></section>
 <section class="split wrap"><figure class="reveal"><img src={detail.gallery[0].src} alt="Cuerpo de la Tagima TW-61 Jazz Red" loading="lazy" /></figure><div class="reveal"><p class="k">Dos P-90</p><h2>Más presencia.<br /><em>Más textura.</em></h2><p>Dos pastillas Tagima modelo P-90 para darle a cada frase un perfil claro y con peso.</p><aside><i class="ph-bold ph-waveform" aria-hidden="true"></i><span><strong>P-90 Tagima</strong>Configuración doble</span></aside></div></section>
 <section class="feature-row wrap"><article class="feature reveal"><img src={detail.gallery[1].src} alt="Detalle de la Tagima TW-61" loading="lazy" /><div><p class="k">Controles</p><h3>Todo al alcance.</h3><p>Selector de 3 vías, varitonos, volumen y tono.</p></div></article><article class="feature dark reveal"><div><i class="ph-bold ph-guitar" aria-hidden="true"></i><p class="k">Puente</p><h3>Trémolo de dos pivotes.</h3><p>Puente cromado para explorar el movimiento de cada nota.</p></div><img src={detail.gallery[0].src} alt="Tagima TW-61 Jazz Red" loading="lazy" /></article></section>
 <section class="craft"><div class="wrap"><p class="k">Construcción</p><h2>Álamo, arce<br />y <em>22 trastes.</em></h2><figure class="reveal"><img src={detail.gallery[1].src} alt="Vista de la construcción de la Tagima TW-61" loading="lazy" /></figure></div></section>
 <section class="detail wrap"><div class="reveal"><p class="k">Una voz, varias rutas</p><h2>Tu sonido<br /><em>en las manos.</em></h2><p>El interruptor de varitonos y el selector de tres vías abren distintos puntos de color sin perder una operación directa.</p></div><figure class="reveal"><img src={detail.gallery[0].src} alt="Tagima TW-61 Jazz Red" loading="lazy" /></figure></section>
 <section class="bento wrap"><header><p class="k">Cada detalle cuenta</p><h2>Hecha para<br /><em>explorar.</em></h2></header><div class="bento-grid"><article class="wide reveal"><img src={detail.gallery[0].src} alt="Tagima TW-61 Jazz Red" loading="lazy" /><div><h3>Cuerpo de álamo</h3><p>Base ligera para una guitarra eléctrica de presencia directa.</p></div></article><article class="tall reveal"><img src={detail.gallery[1].src} alt="Tagima TW-61 Jazz Red, segunda vista" loading="lazy" /><div><h3>Mástil de arce</h3><p>Un perfil clásico para recorrer el diapasón.</p></div></article><article class="small reveal"><i class="ph-bold ph-ruler" aria-hidden="true"></i><h3>Tuerca de 43 mm</h3><p>Una medida verificada en la ficha del instrumento.</p></article><article class="small reveal"><i class="ph-bold ph-gear" aria-hidden="true"></i><h3>Clavijeros cromados</h3><p>Hardware cromado para completar el conjunto.</p></article></div></section>
 <section class="final"><div class="wrap"><p class="k">Tagima TW-61 Jazz Red</p><h2>Una guitarra<br />para <em>hacerla tuya.</em></h2><a href={whatsappUrl} target="_blank" rel="noreferrer">Consultar por WhatsApp <i class="ph-bold ph-whatsapp-logo" aria-hidden="true"></i></a></div></section>
 <section class="specs wrap"><header><p class="k">Especificaciones técnicas</p><h2>La ficha,<br /><em>sin misterio.</em></h2></header><dl>{detail.specifications.map((spec) => <div><dt><i class:list={['ph-bold', spec.icon]} aria-hidden="true"></i>{spec.label}</dt><dd>{spec.value}</dd></div>)}</dl></section>
</main>
<script>
 import { gsap } from 'gsap'; import { ScrollTrigger } from 'gsap/ScrollTrigger';
 const page=document.querySelector<HTMLElement>('[data-product-page]');
 if(page){page.querySelectorAll<HTMLButtonElement>('[data-thumb]').forEach((button)=>button.addEventListener('click',()=>{const image=page.querySelector<HTMLImageElement>('[data-main]');if(image&&button.dataset.src){image.src=button.dataset.src;image.alt=button.dataset.alt??''}page.querySelectorAll<HTMLButtonElement>('[data-thumb]').forEach((thumb)=>{const active=thumb===button;thumb.classList.toggle('selected',active);thumb.setAttribute('aria-pressed',String(active))})}));if(!window.matchMedia('(prefers-reduced-motion: reduce)').matches){gsap.registerPlugin(ScrollTrigger);gsap.utils.toArray<HTMLElement>('.reveal').forEach((item)=>gsap.fromTo(item,{scale:.86,opacity:.16},{scale:1,opacity:1,ease:'none',scrollTrigger:{trigger:item,start:'top 86%',end:'bottom 52%',scrub:true}}));gsap.to('.intro h2',{opacity:1,ease:'none',scrollTrigger:{trigger:'.intro',start:'top 80%',end:'bottom 55%',scrub:true}})}}
</script>
<style is:global>
 @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&family=DM+Mono:wght@400;500&display=swap');
 .tw61{--ink:#06080d;--panel:#12151c;--line:rgba(255,255,255,.13);--muted:#9ca4b2;--red:#ef3d43;background:var(--ink);color:#f8f8f7;font-family:Outfit,sans-serif;overflow:hidden}.tw61 *{box-sizing:border-box}.wrap{width:min(1240px,90vw);margin:auto}.tw61 h1,.tw61 h2,.tw61 h3,.tw61 p{margin-top:0}.tw61 h1,.tw61 h2,.tw61 h3{letter-spacing:-.075em;line-height:.85}.tw61 em{font-family:Georgia,serif;font-weight:400;color:var(--red)}.k{color:var(--red);font:500 .63rem/1.2 'DM Mono',monospace;letter-spacing:.15em;text-transform:uppercase}.cta{display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:48px;padding:13px 18px;background:#f6f7f8;color:#090b10;border:1px solid #fff;border-radius:5px;font-size:.85rem;font-weight:800;text-decoration:none;transition:transform .25s cubic-bezier(.16,1,.3,1),box-shadow .25s ease}.cta:hover{transform:translateY(-3px);box-shadow:0 14px 28px rgba(0,0,0,.28)}.tw61 a:focus-visible,.tw61 button:focus-visible{outline:3px solid #fff;outline-offset:4px}
 .hero{position:relative;min-height:100svh;isolation:isolate;background:#05070b;overflow:hidden}.hero-in{position:relative;z-index:2;min-height:100svh;display:flex;flex-direction:column;align-items:center;padding:125px 0 50px;text-align:center}.hero nav{align-self:flex-start;display:flex;gap:9px;color:#aeb5c0;font-size:.72rem}.hero nav a{color:inherit;text-decoration:none}.hero nav span{color:#fff}.hero .k{margin:8vh 0 18px}.hero h1{max-width:1100px;margin-bottom:16px;font-size:clamp(4.2rem,9vw,9.5rem);z-index:3}.hero .lede{max-width:29rem;color:#d8dce2;font-size:1.05rem;line-height:1.45;z-index:3}.hero figure{position:absolute;z-index:2;bottom:3vh;margin:0;width:min(740px,78vw);height:min(49vh,540px);display:grid;place-items:center;filter:drop-shadow(0 32px 42px rgba(0,0,0,.56));pointer-events:none}.hero figure img{width:100%;height:100%;object-fit:contain;mix-blend-mode:multiply;filter:contrast(1.22) saturate(1.25) brightness(1.34)}.hero .cta{position:absolute;z-index:3;bottom:5vh}.aura{position:absolute;z-index:0;inset:0;overflow:hidden;background:radial-gradient(ellipse at 50% 106%,rgba(242,54,53,.54),transparent 43%),linear-gradient(180deg,#03060b,#06070c 55%,#0c1019)}.aura:before,.aura:after,.aura i{content:'';position:absolute;display:block;width:68vw;height:18vh;border-radius:50%;filter:blur(48px);mix-blend-mode:screen;opacity:.65}.aura:before{top:28%;left:-22%;background:#65141c;transform:rotate(-14deg);animation:aura 14s ease-in-out infinite alternate}.aura:after{right:-25%;top:42%;background:#8b1f27;transform:rotate(19deg);animation:aura 18s ease-in-out infinite alternate-reverse}.aura i:nth-child(1){top:56%;left:19%;width:62vw;background:linear-gradient(90deg,transparent,#ff3c36,transparent);transform:rotate(-6deg)}.aura i:nth-child(2){top:8%;left:40%;width:26vw;height:50vh;background:#1f1524;opacity:.36}.aura i:nth-child(3){bottom:-12%;left:32%;width:35vw;height:35vw;background:#fc4942;opacity:.32}@keyframes aura{to{transform:translateX(18vw) translateY(6vh) rotate(10deg);opacity:.82}}
 .buy{display:grid;grid-template-columns:1.08fr .92fr;gap:clamp(50px,9vw,140px);padding:20vh 0}.gallery{display:grid;grid-template-columns:72px minmax(0,1fr);gap:15px}.thumbs{display:grid;align-content:start;gap:12px}.thumbs button{width:72px;aspect-ratio:1;padding:3px;background:transparent;border:1px solid var(--line);cursor:pointer}.thumbs button.selected{border-color:#fff}.thumbs img{width:100%;height:100%;object-fit:cover}.gallery figure{height:680px;margin:0;background:#151519;overflow:hidden}.gallery figure img{width:100%;height:100%;object-fit:cover;transition:transform .7s cubic-bezier(.16,1,.3,1),opacity .25s ease}.gallery figure:hover img{transform:scale(1.045)}.buy-copy{align-self:center}.buy-copy h2{font-size:clamp(3.4rem,6vw,6.8rem);margin-bottom:25px}.price{margin-bottom:4px;font-size:clamp(2.3rem,3.7vw,4rem);letter-spacing:-.07em}.reference{color:var(--muted);font-size:.78rem}.description{max-width:500px;margin:30px 0;color:var(--muted);line-height:1.55}.finish{display:flex;align-items:center;gap:12px;padding:22px 0;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}.finish>i{width:30px;height:30px;background:linear-gradient(135deg,#f2504e,#831c22);border:1px solid rgba(255,255,255,.4);border-radius:50%}.finish span{display:grid;gap:2px}.finish strong{font-size:.78rem}.finish small{color:var(--muted)}.facts{display:flex;gap:22px;flex-wrap:wrap;margin:20px 0;color:#d8dbe2;font-size:.75rem}.facts i{margin-right:6px;color:var(--red)}.buy-cta{width:100%;margin-top:10px;background:var(--red);color:#fff;border-color:var(--red)}
 .intro{padding:20vh 0;background:#161719;text-align:center}.intro>div{max-width:970px}.intro h2{margin-bottom:30px;font-size:clamp(3.6rem,7.5vw,8.2rem);opacity:.14}.intro>div>p:last-child{max-width:520px;margin:auto;color:var(--muted);line-height:1.55}.visual{position:relative;height:min(80vw,880px);overflow:hidden}.visual img{width:100%;height:100%;object-fit:cover;filter:contrast(1.06) brightness(.72)}.visual:after{content:'';position:absolute;inset:0;background:linear-gradient(90deg,rgba(0,0,0,.5),transparent 62%)}.visual div{position:absolute;z-index:2;left:max(5vw,calc((100vw - 1240px)/2));bottom:11%;font-size:clamp(3rem,7vw,8rem);line-height:.83;letter-spacing:-.08em}.visual .k{font-size:.62rem}.split{display:grid;grid-template-columns:1fr .86fr;gap:clamp(50px,9vw,150px);align-items:center;padding:20vh 0}.split figure,.detail figure{height:650px;margin:0;overflow:hidden;background:#17181d}.split figure img,.detail figure img{width:100%;height:100%;object-fit:cover;transition:transform .8s ease}.split figure:hover img,.detail figure:hover img{transform:scale(1.05)}.split h2,.detail h2,.bento h2,.specs h2{font-size:clamp(3.2rem,6vw,6.8rem)}.split>div>p:not(.k),.detail>div>p:not(.k){max-width:470px;margin:28px 0;color:var(--muted);line-height:1.55}.split aside{display:flex;gap:12px;align-items:center;padding:16px;border:1px solid var(--line);max-width:380px}.split aside i{color:var(--red);font-size:1.45rem}.split aside span{display:grid;gap:3px;color:var(--muted);font-size:.74rem}.split aside strong{color:#fff}.feature-row{display:grid;grid-template-columns:1fr 1fr;gap:1px;background:var(--line);border:1px solid var(--line)}.feature{min-height:620px;display:flex;flex-direction:column;justify-content:space-between;overflow:hidden;padding:25px;background:#14161b}.feature img{width:100%;height:62%;object-fit:cover;transition:transform .7s cubic-bezier(.16,1,.3,1)}.feature:hover img{transform:scale(1.06)}.feature h3{font-size:clamp(2rem,3.4vw,3.7rem)}.feature p:not(.k){max-width:350px;color:var(--muted);font-size:.85rem;line-height:1.5}.feature.dark{background:#0b0c10}.feature.dark>div{padding-top:16px}.feature.dark>div>i{color:var(--red);font-size:2rem}.feature.dark img{height:50%;object-position:center 30%}
 .craft{padding:20vh 0;background:#05070c}.craft .wrap{text-align:center}.craft h2{margin-bottom:65px;font-size:clamp(3.6rem,7vw,8.2rem)}.craft figure{height:min(70vw,740px);margin:0;overflow:hidden;background:#14151b}.craft img{width:100%;height:100%;object-fit:cover}.detail{display:grid;grid-template-columns:.85fr 1.15fr;gap:9vw;align-items:center;padding:20vh 0}.detail figure{height:570px}.bento{padding:20vh 0}.bento>header{display:flex;justify-content:space-between;align-items:end;margin-bottom:60px}.bento-grid{display:grid;grid-template-columns:repeat(12,1fr);grid-auto-flow:dense;gap:1px;background:var(--line);border:1px solid var(--line)}.bento-grid article{position:relative;overflow:hidden;background:#12141a}.bento-grid article img{width:100%;height:100%;object-fit:cover;transition:transform .7s ease}.bento-grid article:hover img{transform:scale(1.05)}.wide{grid-column:span 7;height:520px}.tall{grid-column:span 5;grid-row:span 2;height:720px}.small{grid-column:span 7;min-height:199px;padding:30px;display:flex;flex-direction:column;justify-content:end}.wide div,.tall div{position:absolute;inset:auto 0 0;padding:80px 26px 26px;background:linear-gradient(transparent,rgba(0,0,0,.88))}.bento h3{margin:0 0 7px;font-size:1.8rem}.bento article p{margin:0;color:#c0c5cc;font-size:.78rem}.small>i{margin-bottom:auto;color:var(--red);font-size:1.7rem}.final{padding:16vh 0;background:linear-gradient(110deg,#7d171e,#ed3c40 48%,#7d161c)}.final>div{display:flex;align-items:end;justify-content:space-between;gap:35px}.final .k{color:#ffd6d4}.final h2{font-size:clamp(4rem,8vw,8.5rem)}.final em{color:#fff}.final a{padding:16px 19px;background:#fff;color:#160406;border-radius:5px;font-size:.88rem;font-weight:800;text-decoration:none;white-space:nowrap}.specs{padding:20vh 0;display:grid;grid-template-columns:.75fr 1.25fr;gap:9vw}.specs dl{margin:0}.specs dl div{display:grid;grid-template-columns:1fr 1fr;gap:25px;padding:18px 0;border-bottom:1px solid var(--line)}.specs dt{display:flex;gap:11px;align-items:center;font-weight:700}.specs dt i{color:var(--red);font-size:1.2rem}.specs dd{margin:0;color:var(--muted)}
 @media(max-width:850px){.hero-in{padding-top:105px}.hero .k{margin-top:7vh}.hero figure{height:44vh;width:94vw}.buy,.split,.detail,.specs{grid-template-columns:1fr;gap:45px}.buy{padding:14vh 0}.gallery figure{height:105vw;max-height:620px}.split,.detail{padding:14vh 0}.split figure,.detail figure{height:105vw;max-height:620px}.feature-row{grid-template-columns:1fr}.feature{min-height:520px}.craft,.bento{padding:14vh 0}.bento>header{display:block}.bento>header h2{margin-top:25px}.final>div{align-items:flex-start;flex-direction:column}.specs{padding:14vh 0}.visual{height:94vw}.visual div{left:6vw}.hero nav{display:none}}@media(max-width:540px){.wrap{width:calc(100% - 40px)}.hero h1{font-size:clamp(4rem,19vw,6rem)}.hero .lede{max-width:18rem;font-size:.92rem}.gallery{grid-template-columns:1fr}.thumbs{grid-template-columns:repeat(2,1fr);grid-row:2}.thumbs button{width:100%}.intro{padding:14vh 0}.intro h2,.craft h2{font-size:clamp(3.2rem,15vw,5rem)}.bento-grid{grid-template-columns:1fr}.wide,.tall,.small{grid-column:span 1;grid-row:auto;height:460px}.small{height:220px}.specs dl div{grid-template-columns:1fr;gap:9px}.final{padding:12vh 0}.final h2{font-size:clamp(3.6rem,16vw,5.6rem)}}@media(prefers-reduced-motion:reduce){.aura:before,.aura:after{animation:none}.cta,.gallery figure img,.feature img,.split figure img,.detail figure img{transition:none}.cta:hover{transform:none}}
 :root[data-theme='light'] .tw61{--ink:#f4f5f7;--panel:#fff;--line:rgba(17,24,39,.16);--muted:#596171;--red:#b52028;color:#111827}:root[data-theme='light'] .hero{background:#0d1018;color:#fff}:root[data-theme='light'] .hero nav span{color:#fff}:root[data-theme='light'] .gallery figure,:root[data-theme='light'] .split figure,:root[data-theme='light'] .detail figure,:root[data-theme='light'] .craft figure{background:#e8e9ed}:root[data-theme='light'] .intro,:root[data-theme='light'] .feature,:root[data-theme='light'] .bento-grid article{background:#fff}:root[data-theme='light'] .feature.dark{background:#161820;color:#fff}:root[data-theme='light'] .visual,:root[data-theme='light'] .final{color:#fff}
</style>
