---
import type { ProductDetail } from '../../data/productDetails';
interface Props { detail: ProductDetail; whatsappUrl: string }
const { detail, whatsappUrl } = Astro.props;
const { product } = detail;
---
<section class="product-craft product-section-frame product-reveal"><figure class="craft-main"><img src="/products/acustica-serie-01/neck.png" alt="Detalle del mástil de la Acústica Serie 01" loading="lazy" /></figure><div class="craft-copy"><p class="product-kicker">Comodidad y control</p><h2>Cómoda desde<br /><em>el primer acorde.</em></h2><p>El mástil familiar y la construcción equilibrada te ayudan a concentrarte en ejecutar, practicar y disfrutar.</p><figure><img src="/products/acustica-serie-01/bridge.png" alt="Puente de madera y seis cuerdas de acero" loading="lazy" /><figcaption><i class="ph-bold ph-metronome" aria-hidden="true"></i><span><strong>Afinación estable</strong>Componentes elegidos para mantener cada nota.</span></figcaption></figure></div></section><section class="product-specs product-section-frame product-reveal"><div class="specs-copy"><p class="product-kicker">Ficha del instrumento</p><h2>Cada detalle,<br /><em>bien elegido.</em></h2><dl>{detail.specifications.map((spec) => <div><dt><i class:list={['ph-bold', spec.icon]} aria-hidden="true"></i>{spec.label}</dt><dd>{spec.value}</dd></div>)}</dl></div><figure class="specs-media"><img src="/products/acustica-serie-01/bridge.png" alt="Detalle de la construcción del puente" loading="lazy" /></figure></section><section class="product-final-cta"><div><p class="product-kicker">Acústica Serie 01 · {product.brand}</p><h2>¿Lista para sonar?</h2></div><a href={whatsappUrl} target="_blank" rel="noreferrer">Consultar por WhatsApp <i class="ph-bold ph-whatsapp-logo" aria-hidden="true"></i></a></section>
