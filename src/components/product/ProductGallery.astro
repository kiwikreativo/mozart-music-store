---
import type { ProductDetail } from '../../data/productDetails';
interface Props { detail: ProductDetail; price: string; whatsappUrl: string }
const { detail, price, whatsappUrl } = Astro.props;
const { product } = detail;
---
<section class="product-purchase product-section-frame product-reveal"><div class="product-gallery"><div class="product-thumbnails" aria-label="Imágenes del producto">{detail.gallery.map((media, index) => <button type="button" class:list={[index === 0 && 'is-active']} aria-label={`Ver imagen ${index + 1} de ${product.model}`} aria-pressed={index === 0 ? 'true' : 'false'} data-gallery-thumb data-src={media.src} data-alt={media.alt}><img src={media.src} alt="" /></button>)}</div><div class="product-gallery-main"><img src={detail.gallery[0].src} alt={detail.gallery[0].alt} data-gallery-main /></div></div><div class="product-purchase-copy"><p class="product-kicker">Disponible en Mozart</p><h2>{product.brand}<br />{product.model}</h2><p class="purchase-price">{price}</p><p>{detail.description}</p><div class="finish-choice"><span>Acabado</span><button type="button" aria-pressed="true"><span aria-hidden="true"></span>Natural</button></div><ul class="purchase-facts"><li><i class="ph-bold ph-list-numbers" aria-hidden="true"></i><strong>6 cuerdas</strong><span>Acero</span></li><li><i class="ph-bold ph-hand" aria-hidden="true"></i><strong>Diestro</strong><span>Orientación</span></li><li><i class="ph-bold ph-graduation-cap" aria-hidden="true"></i><strong>Principiante</strong><span>Nivel</span></li></ul><a class="product-cta product-cta-wide" href={whatsappUrl} target="_blank" rel="noreferrer">Consultar por WhatsApp <i class="ph-bold ph-whatsapp-logo" aria-hidden="true"></i></a></div></section>
