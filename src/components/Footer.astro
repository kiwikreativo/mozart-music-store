---
interface Props { whatsappUrl: string; variant?: 'landing' | 'standard' }
const { whatsappUrl, variant = 'standard' } = Astro.props;
const facebookUrl = import.meta.env.PUBLIC_FACEBOOK_URL ?? 'https://www.facebook.com/mozartmusicstore';
const instagramUrl = import.meta.env.PUBLIC_INSTAGRAM_URL ?? 'https://www.instagram.com/mozartmusicstore';
---

<footer class:list={['site-footer', `site-footer--${variant}`]}>
	<div class="site-footer-panel">
		<div class="site-footer-cta">
			<p class="site-footer-kicker">Mozart · Alajuela</p>
			<h2>Tu próximo sonido<br /><em>empieza aquí.</em></h2>
			<a class="site-footer-contact" href={whatsappUrl} target="_blank" rel="noreferrer">Hablar por WhatsApp <i class="ph-bold ph-arrow-up-right" aria-hidden="true"></i></a>
		</div>
		<div class="site-footer-utility">
			<div><span>Visítanos</span><strong>Alajuela, Costa Rica</strong></div>
			<div><span>Escríbenos</span><a href={whatsappUrl} target="_blank" rel="noreferrer">WhatsApp <i class="ph-bold ph-whatsapp-logo" aria-hidden="true"></i></a></div>
			<div><span>Síguenos</span><div class="site-footer-social"><a href={facebookUrl} target="_blank" rel="noreferrer" aria-label="Facebook"><i class="ph-bold ph-facebook-logo" aria-hidden="true"></i></a><a href={instagramUrl} target="_blank" rel="noreferrer" aria-label="Instagram"><i class="ph-bold ph-instagram-logo" aria-hidden="true"></i></a></div></div>
		</div>
		<div class="site-footer-bottom">
			<nav aria-label="Navegación del pie de página"><a href="/instrumentos">Instrumentos</a><a href="/audio">Audio</a><a href="/accesorios">Accesorios</a><a href="/marcas">Marcas</a><a href="/">Inicio</a></nav>
			<p>© {new Date().getFullYear()} Mozart Music Store</p>
		</div>
	</div>
</footer>

<style>
	.site-footer--standard {
		font-family: 'Elms Sans', sans-serif;
	}
</style>
