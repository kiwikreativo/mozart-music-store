---
import CategoryMarquee from './landing/CategoryMarquee.astro';
import ClosingCta from './landing/ClosingCta.astro';
import Footer from './landing/Footer.astro';
import Hero from './landing/Hero.astro';
import InstrumentCatalogue from './landing/InstrumentCatalogue.astro';
import Manifesto from './landing/Manifesto.astro';
import ProductSelection from './landing/ProductSelection.astro';

const whatsappNumber = import.meta.env.PUBLIC_WHATSAPP_NUMBER ?? '';
const whatsappLink = (product: string) => {
	const text = encodeURIComponent(`Hola Mozart, quiero consultar por ${product}.`);
	return whatsappNumber ? `https://wa.me/${whatsappNumber}?text=${text}` : `https://wa.me/?text=${text}`;
};
const products = [
	{ name: 'Yamaha F310', type: 'Guitarra acústica', price: 'Desde ₡95.000', image: 'https://images.unsplash.com/photo-1510915361894-db8b60106cb1?auto=format&fit=crop&w=1200&q=85' },
	{ name: 'Casio CDP-S110', type: 'Piano digital', price: 'Desde ₡295.000', image: 'https://images.unsplash.com/photo-1520523839897-bd0b52f945a0?auto=format&fit=crop&w=1200&q=85' },
	{ name: 'Squier Sonic Bass', type: 'Bajo eléctrico', price: 'Desde ₡145.000', image: 'https://images.unsplash.com/photo-1558098329-a11cff621064?auto=format&fit=crop&w=1200&q=85' },
];
---

<main class="landing-page">
	<Hero />
	<Manifesto />
	<ProductSelection {products} {whatsappLink} />
	<InstrumentCatalogue catalogueUrl={whatsappLink('el catálogo completo')} />
	<!-- <CategoryMarquee />
	<ClosingCta whatsappUrl={whatsappLink('un instrumento')} /> -->
</main>
<Footer whatsappUrl={whatsappLink('Mozart')} />

<script>
	import { gsap } from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';
	gsap.registerPlugin(ScrollTrigger);
	gsap.from('.hero-copy > *', { y: 36, opacity: 0, duration: 1, stagger: 0.12, ease: 'power3.out', delay: 0.15 });
	gsap.from('.hero-art', { scale: 0.88, opacity: 0, duration: 1.2, ease: 'power3.out' });
	gsap.utils.toArray<HTMLElement>('.product-card').forEach((card) => gsap.fromTo(card, { scale: 0.86, opacity: 0.15 }, { scale: 1, opacity: 1, ease: 'none', scrollTrigger: { trigger: card, start: 'top 85%', end: 'bottom 50%', scrub: true } }));
	ScrollTrigger.matchMedia({ '(min-width: 900px)': () => ScrollTrigger.create({ trigger: '.catalogue', start: 'top top+=48', end: 'bottom bottom', pin: '.catalogue-sticky', pinSpacing: false }) });
	gsap.fromTo('.manifesto p', { opacity: 0.13 }, { opacity: 1, ease: 'none', scrollTrigger: { trigger: '.manifesto', start: 'top 75%', end: 'bottom 45%', scrub: true } });
	gsap.utils.toArray<HTMLElement>('.catalogue-item').forEach((item) => gsap.fromTo(item, { scale: 0.82, opacity: 0.2 }, { scale: 1, opacity: 1, ease: 'none', scrollTrigger: { trigger: item, start: 'top 86%', end: 'bottom 55%', scrub: true } }));
</script>

<style is:global>
	@import url('https://fonts.googleapis.com/css2?family=Cabinet+Grotesk:wght@400;500;600;700;800&family=DM+Mono:wght@400;500&family=Geist:wght@400;500;600;700&family=JetBrains+Mono:wght@600&display=swap');
	*{box-sizing:border-box}html{scroll-behavior:smooth;background:#030712}body{margin:0;background:#030712;color:#fff;font-family:'Geist',sans-serif}main{overflow-x:hidden;width:100%;max-width:100%}.nav{position:absolute;z-index:5;top:0;left:0;width:100%;padding:28px 4vw;display:flex;justify-content:space-between;align-items:center;color:#fff}.wordmark{font-size:1.35rem;font-weight:900;letter-spacing:-.08em;color:inherit;text-decoration:none}.wordmark span{font-size:.47em;vertical-align:top;margin-left:.12rem}.nav-links{display:flex;gap:24px;align-items:center;font-family:'JetBrains Mono',monospace;font-size:.76rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase}.nav a{color:inherit;text-decoration:none}.nav-cta{border:1px solid #27272a;background:rgba(24,24,27,.72);padding:10px 14px;border-radius:999px}.hero{min-height:100svh;background:#030712;color:#fff;display:grid;grid-template-columns:1fr 1.06fr;align-items:end;overflow:hidden;position:relative}.hero-copy{position:relative;z-index:2;padding:12vh 4vw 9vh}.eyebrow{font-family:'JetBrains Mono',monospace;text-transform:uppercase;letter-spacing:.16em;font-weight:800;font-size:.68rem;margin:0 0 24px}h1,h2,h3,p{margin-top:0}h1,h2{letter-spacing:-.075em;font-weight:800;line-height:.87}h1{max-width:72rem;font-size:clamp(3.9rem,7.5vw,8.8rem);margin-bottom:34px}em{color:#06b6d4;font-family:Georgia,serif;font-weight:400;letter-spacing:-.1em}.hero-note{max-width:26rem;color:#a1a1aa;line-height:1.45;font-size:1rem;margin-bottom:34px}.button{display:inline-flex;gap:20px;align-items:center;border-radius:999px;padding:15px 21px;font-size:.76rem;font-weight:800;letter-spacing:.03em;text-decoration:none;transition:transform .3s ease,background .3s ease}.button:hover{transform:translateY(-3px)}.button-light,.button-dark{background:#4f46e5;color:#fff}.hero-art{height:86vh;position:relative;overflow:hidden;border-radius:220px 0 0 0}.hero-art:after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,#030712 0%,transparent 34%),linear-gradient(0deg,rgba(3,7,18,.55),transparent 45%)}.hero-art img{width:100%;height:100%;object-fit:cover;filter:grayscale(1) contrast(1.2);opacity:.84}.hero-index{position:absolute;bottom:30px;right:4vw;z-index:1;font-size:.72rem;letter-spacing:.15em}.orb{position:absolute;z-index:1;border-radius:50%;filter:blur(3px);mix-blend-mode:screen}.orb-one{height:19vw;width:19vw;background:#06b6d4;top:8%;right:15%;opacity:.34}.orb-two{height:8vw;width:8vw;background:#4f46e5;bottom:19%;left:15%;opacity:.32}.manifesto{min-height:64vh;display:grid;place-items:center;padding:14vh 8vw;background:#18181b;color:#fff}.manifesto p{max-width:62rem;font-size:clamp(2rem,4.2vw,4.9rem);line-height:.99;letter-spacing:-.065em;margin:0;text-align:center;font-weight:750}.section-wrap{padding:19vh 4vw}.section-heading{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:72px}.section-heading h2,.catalogue h2,.closing h2{font-size:clamp(3.2rem,6.2vw,7rem);margin:0}.product-grid{display:grid;grid-template-columns:repeat(12,1fr);grid-auto-flow:dense;gap:1px;background:#27272a;border:1px solid #27272a}.product-card{background:#18181b;padding:16px}.product-1{grid-column:span 7}.product-2{grid-column:span 5}.product-3{grid-column:span 12;display:grid;grid-template-columns:1.2fr .8fr;gap:20px}.product-image{display:block;height:clamp(340px,48vw,680px);position:relative;overflow:hidden;background:#030712}.product-3 .product-image{height:420px}.product-image img{width:100%;height:100%;object-fit:cover;filter:grayscale(1) contrast(1.13);transition:transform .7s cubic-bezier(.2,.7,.2,1),filter .7s ease}.product-image:hover img{transform:scale(1.06);filter:grayscale(.2) contrast(1.1)}.product-image span{position:absolute;top:14px;left:14px;color:#fff;font-size:.72rem;font-weight:700;z-index:1}.product-info{padding:18px 0 14px;display:flex;justify-content:space-between;align-items:flex-end}.product-info p{color:#a1a1aa;font-family:'JetBrains Mono',monospace;font-size:.76rem;margin-bottom:5px}.product-info h3{font-size:clamp(1.6rem,2.6vw,3rem);letter-spacing:-.065em;margin:0}.product-info .price{color:#fff;font-weight:700;text-align:right}.text-link{display:block;color:#fff;font-family:'JetBrains Mono',monospace;font-size:.73rem;text-decoration:none;font-weight:800;text-transform:uppercase;letter-spacing:.09em;border-bottom:1px solid #27272a;padding:6px 0}.text-link span{float:right;font-size:1rem}.catalogue{padding:18vh 4vw;display:grid;grid-template-columns:1fr 1fr;gap:8vw;background:#030712;color:#fff}.catalogue-sticky{align-self:start;padding-top:2vh}.catalogue-sticky h2{margin-bottom:45px}.catalogue-list{display:grid;gap:50px}.catalogue-item{position:relative;overflow:hidden}.catalogue-item span{position:absolute;z-index:1;left:20px;bottom:18px;color:#fff;font-size:clamp(1.4rem,2.4vw,2.5rem);font-weight:800;letter-spacing:-.06em}.catalogue-item img{width:100%;display:block;aspect-ratio:1.34;object-fit:cover;filter:grayscale(1) contrast(1.08) brightness(.72);transition:transform .7s ease}.catalogue-item:hover img{transform:scale(1.05)}.marquee{background:#4f46e5;overflow:hidden;white-space:nowrap;padding:20px 0;font-size:clamp(1.4rem,3vw,3.6rem);font-weight:800;letter-spacing:-.06em}.marquee div{animation:scroll 28s linear infinite;width:max-content}@keyframes scroll{to{transform:translateX(-25%)}}.closing{min-height:86vh;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:12vh 4vw;color:#fff;background:radial-gradient(circle at 50% 20%,#18181b,#030712 62%)}.closing h2{margin-bottom:45px}footer{background:#030712;color:#fff;padding:26px 4vw;display:flex;gap:20px;justify-content:space-between;align-items:center;border-top:1px solid #27272a;font-size:.75rem}footer p{margin:0;color:#a1a1aa}footer a{color:inherit;text-decoration:none}.button:focus-visible,.nav a:focus-visible,.text-link:focus-visible{outline:2px solid #06b6d4;outline-offset:4px}@media(max-width:760px){.nav{padding:20px 6vw}.nav-links a:not(.nav-cta){display:none}.hero{grid-template-columns:1fr;min-height:820px}.hero-copy{padding:150px 6vw 30px}.hero-art{height:46vh;border-radius:100px 0 0 0;margin-left:10vw}.section-wrap{padding:14vh 6vw}.section-heading{display:block}.section-heading h2{margin-top:30px}.product-grid{display:block;background:transparent;border:0}.product-card{padding:0 0 48px;margin-bottom:20px}.product-info,.text-link{margin-right:16px;margin-left:16px}.product-3{display:block}.product-3 .product-image,.product-2 .product-image,.product-image{height:110vw;max-height:520px}.catalogue{padding:14vh 6vw;grid-template-columns:1fr;gap:9vh}.catalogue-list{gap:24px}.catalogue-item img{aspect-ratio:1.1}footer{padding:24px 6vw;flex-wrap:wrap}footer p{order:3;width:100%}}

	.button{
		position:relative;
		isolation:isolate;
		overflow:hidden;
		min-height:48px;
		border:1px solid rgba(255,255,255,.34);
		border-radius:18px;
		background:
			linear-gradient(145deg,rgba(255,255,255,.2),rgba(255,255,255,.03) 58%),
			rgba(79,70,229,.9);
		box-shadow:
			inset 0 1px 0 rgba(255,255,255,.36),
			inset 0 -1px 0 rgba(34,30,107,.42),
			0 9px 24px rgba(49,46,129,.25);
		backdrop-filter:blur(14px) saturate(135%);
		-webkit-backdrop-filter:blur(14px) saturate(135%);
		transition:transform .24s cubic-bezier(.16,1,.3,1),box-shadow .24s ease,filter .24s ease;
	}
	.button::before{
		content:"";
		position:absolute;
		z-index:-1;
		inset:1px;
		border-radius:16px;
		background:linear-gradient(135deg,rgba(255,255,255,.15),transparent 45%);
		pointer-events:none;
	}
	.button:hover{
		filter:brightness(1.08);
		box-shadow:inset 0 1px 0 rgba(255,255,255,.45),inset 0 -1px 0 rgba(34,30,107,.38),0 13px 28px rgba(49,46,129,.3);
		transform:translateY(-2px);
	}
	.button:active{transform:scale(.98)}
	@media(prefers-reduced-transparency:reduce){.button{background:#4f46e5;backdrop-filter:none;-webkit-backdrop-filter:none}}
	@media(prefers-reduced-motion:reduce){.button{transition:none}.button:hover,.button:active{transform:none}}

	/* Landing art direction: wide editorial type, instrument photography and cyan/violet light. */
	.landing-page{--ink:#020713;--night:#050b18;--panel:#0a1322;--line:rgba(174,215,233,.14);--mist:#a8b5c6;--cyan:#00b8dc;--violet:#6b4ff8;--product-card-bg:#09111e;--product-card-bg-hover:#0c1828;--product-card-text:#fff;--product-card-muted:#8fa3b8;--product-card-border:var(--line);--product-card-focus:var(--cyan);background:var(--ink);color:#f7f9fc;font-family:'Cabinet Grotesk',sans-serif}
	.navbar{color:#f7f9fc}.navbar-shell{background:rgba(3,10,23,.76);border-color:rgba(174,215,233,.16);box-shadow:0 12px 36px rgba(0,0,0,.26),inset 0 1px 0 rgba(255,255,255,.08)}.navbar-brand,.navbar-link,.navbar-trigger,.navbar-whatsapp{color:#f7f9fc}.navbar-link{color:#9daebe}.navbar-dropdown,.navbar-mobile{background:rgba(3,10,23,.97);border-color:rgba(174,215,233,.16)}.navbar-dropdown a,.navbar-mobile > a,.mobile-parent > a,.mobile-group > div a{color:#f7f9fc}.navbar-whatsapp{border-color:rgba(174,215,233,.22);background:rgba(255,255,255,.07)}.theme-switch{color:#c5d2df;background:rgba(255,255,255,.06);border-color:rgba(174,215,233,.16)}.theme-switch button[aria-pressed="true"]{color:#fff;background:rgba(255,255,255,.15);box-shadow:none}.navbar-toggle{color:#fff;background:rgba(255,255,255,.1)}
	.landing-page .hero{min-height:100svh;background:radial-gradient(circle at 74% 52%,rgba(0,184,220,.24),transparent 27%),radial-gradient(circle at 58% 20%,rgba(68,91,194,.12),transparent 30%),var(--ink);grid-template-columns:minmax(0,1fr) minmax(430px,.92fr);align-items:center;padding:9rem max(5vw,30px) 4.5rem;gap:4vw}
	.landing-page .hero-copy{padding:0;max-width:54rem}.landing-page .eyebrow{color:var(--cyan);font-family:'DM Mono',monospace;font-size:.62rem;letter-spacing:.19em;margin-bottom:1.65rem}.landing-page h1,.landing-page h2,.landing-page h3{font-family:'Cabinet Grotesk',sans-serif;font-weight:700}.landing-page h1{max-width:72rem;font-size:clamp(3.7rem,7vw,7.4rem);line-height:.82;letter-spacing:-.085em;margin-bottom:2rem}.landing-page em{color:var(--cyan);font-family:Georgia,serif;font-weight:400}.landing-page .hero-note{max-width:31rem;color:#b1c0cf;font-size:clamp(1rem,1.25vw,1.2rem);line-height:1.48;margin-bottom:2rem}.landing-page .hero-actions{display:flex;gap:1.4rem;align-items:center;flex-wrap:wrap}.landing-page .button{border:1px solid rgba(255,255,255,.18);border-radius:7px;background:linear-gradient(100deg,#7259f7,#4b48e8);box-shadow:0 12px 35px rgba(62,47,217,.25);color:#fff;font-family:'Cabinet Grotesk',sans-serif;font-size:.95rem;letter-spacing:0;padding:15px 20px}.landing-page .hero-link{color:#eff6fd;font-size:.92rem;font-weight:700;text-decoration:none}.landing-page .hero-link i{color:var(--cyan);margin-left:.35rem}.landing-page .hero-art{height:min(68vh,720px);border-radius:17px;box-shadow:0 30px 80px rgba(0,0,0,.36);border:1px solid rgba(255,255,255,.1)}.landing-page .hero-art:after{background:linear-gradient(145deg,rgba(1,7,19,.38),transparent 56%),linear-gradient(0deg,rgba(1,7,19,.6),transparent 28%)}.landing-page .hero-art img{filter:grayscale(.22) contrast(1.1) brightness(.91);opacity:1}.landing-page .hero-index{font-family:'DM Mono',monospace;font-size:.58rem;color:#dce9f2;right:1.5rem;bottom:1.25rem}
	.landing-page .manifesto{min-height:72vh;padding:16vh max(7vw,30px);background:#17191d;position:relative}.landing-page .manifesto:before{content:'';position:absolute;top:0;width:1px;height:100%;background:rgba(255,255,255,.08)}.landing-page .manifesto p{max-width:75rem;font-size:clamp(2.65rem,5.65vw,6.9rem);line-height:.89;letter-spacing:-.083em;text-align:left}.landing-page .manifesto em{white-space:nowrap}
	.landing-page .section-wrap{padding:18vh max(5vw,30px);background:var(--night)}.landing-page .section-heading{display:grid;grid-template-columns:1fr minmax(360px,1.5fr) minmax(180px,.55fr);gap:3rem;align-items:end;margin:0 0 5rem}.landing-page .section-heading h2{font-size:clamp(3.4rem,6vw,7rem);line-height:.83;margin:0}.landing-page .section-intro{color:var(--mist);font-size:1rem;line-height:1.45;margin:0 0 .3rem}.landing-page .product-grid{gap:1px;background:var(--product-card-border);border:1px solid var(--product-card-border);grid-auto-flow:dense}.landing-page .product-card{background:var(--product-card-bg);padding:16px;transition:background .4s ease}.landing-page .product-card:hover{background:var(--product-card-bg-hover)}.landing-page .product-card:focus-within{outline:2px solid var(--product-card-focus);outline-offset:3px}.landing-page .product-image{height:clamp(330px,39vw,590px);border-radius:3px}.landing-page .product-3{grid-column:span 12;grid-template-columns:1fr 1fr;align-items:center;padding:0;gap:0}.landing-page .product-3 .product-image{height:420px}.landing-page .product-3 .product-info,.landing-page .product-3 .text-link{margin-left:2rem;margin-right:2rem}.landing-page .product-image img{filter:grayscale(.25) contrast(1.1) brightness(.78)}.landing-page .product-image:hover img{transform:scale(1.07);filter:grayscale(0) contrast(1.04) brightness(.95)}.landing-page .product-image span{font-family:'DM Mono',monospace;font-size:.6rem;color:var(--cyan)}.landing-page .product-info{padding:1.5rem .15rem 1.1rem}.landing-page .product-info p{font-family:'DM Mono',monospace;color:var(--product-card-muted);font-size:.65rem;letter-spacing:.05em}.landing-page .product-info h3{font-size:clamp(1.9rem,3vw,3.75rem);line-height:.87}.landing-page .product-info .price{color:var(--product-card-text);font-family:'Cabinet Grotesk',sans-serif;font-size:1rem}.landing-page .text-link{border-color:var(--product-card-border);color:var(--product-card-text);font-family:'Cabinet Grotesk',sans-serif;font-size:.8rem;letter-spacing:.04em;text-transform:none}.landing-page .text-link i{color:var(--cyan)}
	.landing-page .catalogue{padding:20vh max(5vw,30px);gap:10vw;background:var(--ink)}.landing-page .catalogue-sticky h2{font-size:clamp(3.5rem,6.1vw,7.3rem);line-height:.82;margin-bottom:2rem}.landing-page .catalogue-sticky > p:not(.eyebrow){max-width:25rem;color:var(--mist);line-height:1.5;margin:0 0 2rem}.landing-page .catalogue-list{gap:2.5rem}.landing-page .catalogue-item{border:1px solid var(--line);border-radius:4px}.landing-page .catalogue-item img{filter:grayscale(.35) contrast(1.15) brightness(.63)}.landing-page .catalogue-item:hover img{filter:grayscale(0) contrast(1.1) brightness(.82)}.landing-page .catalogue-item span{font-size:clamp(1.6rem,2.6vw,3.1rem);letter-spacing:-.07em}.landing-page .marquee{background:linear-gradient(100deg,#4f46cb,#06a7cf);font-family:'Cabinet Grotesk',sans-serif;padding:1.6rem 0}.landing-page .closing{min-height:72vh;background:linear-gradient(100deg,#4435b8,#1966e6 60%,#06a6ca);align-items:flex-start;text-align:left;padding:13vh max(8vw,30px)}.landing-page .closing h2{font-size:clamp(4rem,8vw,9rem);line-height:.8;margin-bottom:2.5rem}.landing-page .closing em{color:#fff}.landing-page + footer,footer{background:var(--ink);border-color:var(--line);padding:2rem max(5vw,30px)}
	@media(max-width:900px){.landing-page .hero{grid-template-columns:1fr;padding-top:8.5rem}.landing-page .hero-art{height:54vh;max-width:700px;width:100%;justify-self:end}.landing-page .section-heading{grid-template-columns:1fr;gap:1.5rem}.landing-page .section-intro{max-width:35rem}.landing-page .product-3{display:block}.landing-page .product-3 .product-image{height:70vw}.landing-page .catalogue{grid-template-columns:1fr;gap:5rem}.landing-page .catalogue-sticky{position:static!important}.landing-page .manifesto p{text-align:left}}
	@media(max-width:600px){.landing-page .hero{padding:7.5rem 22px 3rem;min-height:auto}.landing-page h1{font-size:clamp(3.35rem,15vw,5rem)}.landing-page .hero-art{height:48vh;border-radius:12px}.landing-page .manifesto{min-height:56vh;padding:12vh 22px}.landing-page .manifesto p{font-size:clamp(2.45rem,11vw,4rem)}.landing-page .section-wrap,.landing-page .catalogue{padding:13vh 22px}.landing-page .product-card{padding:10px}.landing-page .product-info{padding:1.2rem .4rem}.landing-page .product-3 .product-info,.landing-page .product-3 .text-link{margin-left:.4rem;margin-right:.4rem}.landing-page .closing{padding:12vh 22px;min-height:58vh}.landing-page .closing h2{font-size:clamp(4rem,17vw,6rem)}}

	html[data-theme='light'],html[data-theme='light'] body{background:var(--color-bg);color:var(--color-text)}
	html[data-theme='light'] .hero{background:var(--color-bg);color:var(--color-text)}
	html[data-theme='light'] .hero-note{color:var(--color-text-muted)}
	html[data-theme='light'] .hero-art:after{background:linear-gradient(90deg,var(--hero-overlay-start) 0%,transparent 34%),linear-gradient(0deg,var(--hero-overlay-bottom),transparent 45%)}
	html[data-theme='light'] .hero-index,html[data-theme='light'] .product-image span,html[data-theme='light'] .catalogue-item span{color:#fff;text-shadow:0 1px 12px rgba(3,7,18,.45)}
	html[data-theme='light'] .manifesto{background:var(--color-surface-alt);color:var(--color-text)}
	html[data-theme='light'] .selection{background:var(--color-bg);color:var(--color-text)}
	html[data-theme='light'] .product-grid{background:var(--color-border);border-color:var(--color-border)}
	html[data-theme='light'] .landing-page{--product-card-bg:var(--color-surface);--product-card-bg-hover:var(--color-surface-alt);--product-card-text:var(--color-text);--product-card-muted:var(--color-text-muted);--product-card-border:var(--color-border);--product-card-focus:var(--color-focus)}
	html[data-theme='light'] .product-image{background:var(--color-surface-deep)}
	html[data-theme='light'] .catalogue{background:var(--color-bg);color:var(--color-text)}
	html[data-theme='light'] .closing{color:var(--color-text);background:radial-gradient(circle at 50% 20%,var(--color-surface),var(--color-bg) 62%)}
	html[data-theme='light'] footer{background:var(--color-bg);color:var(--color-text);border-color:var(--color-border)}
	html[data-theme='light'] footer p{color:var(--color-text-muted)}
	html[data-theme='light'] em{color:var(--color-accent)}
