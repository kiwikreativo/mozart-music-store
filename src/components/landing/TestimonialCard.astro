---
import type { Testimonial } from '../../data/testimonials';

interface Props { testimonial: Testimonial; index: number }
const { testimonial, index } = Astro.props;
---

<article class:list={['testimonial-card', index === 1 && 'testimonial-card-featured']}>
	<header>
		<h3>{testimonial.name}</h3>
		<div class="testimonial-rating" role="img" aria-label={`${testimonial.rating} de 5 estrellas`}>
			{Array.from({ length: testimonial.rating }, () => <i class="ph-fill ph-star" aria-hidden="true"></i>)}
		</div>
	</header>
	<p>“{testimonial.text}”</p>
</article>

<style>
	.testimonial-card{min-height:280px;padding:26px;background:var(--testimonial-card-bg,var(--color-surface-deep));border:1px solid var(--testimonial-card-border,var(--color-border));border-radius:20px;display:flex;flex-direction:column;justify-content:flex-start;font-family:'Elms Sans',sans-serif;transition:transform .45s cubic-bezier(.16,1,.3,1),background-color .25s ease,border-color .25s ease}
	.testimonial-card:hover{transform:translateY(-8px);background:var(--testimonial-card-hover,var(--color-surface-alt))}
	.testimonial-card-featured{background:var(--testimonial-card-featured,var(--color-surface-alt))}
	.testimonial-card header{display:flex;align-items:flex-start;justify-content:space-between;gap:18px}
	.testimonial-card h3{margin:0;font-size:1.1rem;letter-spacing:-.03em}
	.testimonial-rating{display:flex;align-items:center;gap:4px;color:var(--color-accent);font-size:1.15rem;white-space:nowrap}
	.testimonial-card>p{max-width:34rem;margin:20px 0 0;color:var(--color-text);font-size:clamp(1.05rem,1.45vw,1.35rem);line-height:1.55;letter-spacing:-.025em}
	@media(max-width:640px){.testimonial-card{min-height:240px;padding:24px}.testimonial-card>p{margin-top:18px}}
	@media(prefers-reduced-motion:reduce){.testimonial-card{transition:none}.testimonial-card:hover{transform:none}}
</style>
