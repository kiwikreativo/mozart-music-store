---
import TestimonialCard from './TestimonialCard.astro';
import { testimonials } from '../../data/testimonials';

const googleReviewsUrl = 'https://share.google/oycOFkjtIZ9x9I0kN';
const visibleTestimonials = testimonials.slice(0, 3);
---

<section class="testimonials-section section-wrap" aria-labelledby="testimonials-title">
	<div class="testimonials-intro">
		<div>
			<p class="eyebrow">Historias que resuenan</p>
			<h2 id="testimonials-title">Lo que dicen<br /><em>nuestros clientes.</em></h2>
		</div>
		<div class="testimonials-summary">
			<p>Experiencias reales de quienes encontraron en Mozart el instrumento, el consejo o el accesorio para seguir tocando.</p>
			<a href={googleReviewsUrl} target="_blank" rel="noreferrer">Reseñas en Google <i class="ph-bold ph-arrow-up-right" aria-hidden="true"></i></a>
		</div>
	</div>
	<div class="testimonial-grid">
		{visibleTestimonials.map((testimonial, index) => <TestimonialCard {testimonial} {index} />)}
	</div>
	<div class="testimonials-footer">
		<p>La próxima canción también puede empezar con una conversación.</p>
		<a class="button button-dark" href={googleReviewsUrl} target="_blank" rel="noreferrer">Ver más reseñas <i class="ph-bold ph-arrow-up-right" aria-hidden="true"></i></a>
	</div>
</section>

<style>
	.testimonials-section{background:var(--color-bg);color:var(--color-text)}
	.testimonials-intro{display:grid;grid-template-columns:1.15fr .85fr;gap:8vw;align-items:end;margin-bottom:72px}
	.testimonials-intro h2{margin:0;font-size:clamp(3.2rem,6.2vw,7rem)}
	.testimonials-summary{max-width:25rem;color:var(--color-text-muted);line-height:1.55}
	.testimonials-summary p{margin:0 0 22px}
	.testimonials-summary a{display:inline-flex;align-items:center;gap:9px;color:var(--color-text);font:700 .72rem 'JetBrains Mono',monospace;text-transform:uppercase;letter-spacing:.08em;text-decoration:none}
	.testimonials-summary a:hover{color:var(--color-accent)}
	.testimonial-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px;background:transparent;border:0}
	.testimonial-card{min-height:280px;padding:26px;background:var(--testimonial-card-bg,var(--color-surface-deep));border:1px solid var(--testimonial-card-border,var(--color-border));border-radius:20px;display:flex;flex-direction:column;justify-content:flex-start;transition:transform .45s cubic-bezier(.16,1,.3,1),background-color .25s ease,border-color .25s ease}
	.testimonial-card:hover{transform:translateY(-8px);background:var(--testimonial-card-hover,var(--color-surface-alt))}
	.testimonial-card-featured{background:var(--testimonial-card-featured,var(--color-surface-alt))}
	.testimonial-card header{display:flex;align-items:flex-start;justify-content:space-between;gap:18px}
	.testimonial-card h3{margin:0;font-size:1.1rem;letter-spacing:-.03em}
	.testimonial-rating{display:flex;align-items:center;gap:4px;color:var(--color-accent);font-size:1.15rem;white-space:nowrap}
	.testimonial-rating span{margin-left:7px;color:var(--color-text-muted);font:600 .65rem 'JetBrains Mono',monospace}
	.testimonial-card>p{max-width:34rem;margin:20px 0 0;color:var(--color-text);font-size:clamp(1.05rem,1.45vw,1.35rem);line-height:1.55;letter-spacing:-.025em}
	.testimonials-footer{display:flex;align-items:center;justify-content:space-between;gap:24px;padding-top:30px}
	.testimonials-footer p{margin:0;color:var(--color-text-muted);font:600 .72rem 'JetBrains Mono',monospace;letter-spacing:.04em}
	.testimonials-footer .button{color:#fff}
	@media(max-width:900px){.testimonials-intro{grid-template-columns:1fr;gap:28px}.testimonial-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.testimonial-card:last-child{grid-column:1/-1}}
	@media(max-width:640px){.testimonials-intro{margin-bottom:44px}.testimonial-grid{display:grid;grid-template-columns:1fr}.testimonial-card:last-child{grid-column:auto}.testimonial-card{min-height:240px;padding:24px}.testimonial-card>p{margin-top:18px}.testimonials-footer{align-items:stretch;flex-direction:column;padding-top:24px}.testimonials-footer .button{justify-content:center;width:100%}}
	@media(prefers-reduced-motion:reduce){.testimonial-card{transition:none}.testimonial-card:hover{transform:none}}
</style>

<style is="global">
	html[data-theme='light'] .testimonials-section{background:var(--color-bg);color:var(--color-text)}
	html[data-theme='light'] .testimonials-section .testimonial-card{--testimonial-card-bg:var(--color-surface);--testimonial-card-hover:var(--color-surface-alt);--testimonial-card-featured:var(--color-surface);--testimonial-card-border:rgba(10,20,35,.2);box-shadow:0 4px 14px rgba(0,0,0,.04)}
	html[data-theme='light'] .testimonials-section .testimonials-footer .button,
	html[data-theme='light'] .testimonials-section .testimonials-footer .button:hover,
	html[data-theme='light'] .testimonials-section .testimonials-footer .button:focus-visible,
	html[data-theme='light'] .testimonials-section .testimonials-footer .button:active{color:var(--color-text)}
	html[data-theme='light'] .testimonials-section .testimonials-footer .button i{color:var(--color-text)}
	html[data-theme='dark'] .testimonials-section{background:var(--color-bg);color:var(--color-text)}
	html[data-theme='dark'] .testimonials-section .testimonial-card{--testimonial-card-bg:#18181b;--testimonial-card-hover:#1c1c1e;--testimonial-card-featured:#1c1c1e;--testimonial-card-border:rgba(255,255,255,.2)}
	html[data-theme='dark'] .testimonials-section .testimonials-footer .button,
	html[data-theme='dark'] .testimonials-section .testimonials-footer .button:hover,
	html[data-theme='dark'] .testimonials-section .testimonials-footer .button:focus-visible,
	html[data-theme='dark'] .testimonials-section .testimonials-footer .button:active{color:var(--color-bg)}
	html[data-theme='dark'] .testimonials-section .testimonials-footer .button i{color:currentColor}
</style>
